.kiro/

# Project-specific
output/*
input/targets.csv
input/order_list.csv
# Personal Fineco export staging area — the preprocessing step is
# optional and only runs when the user invokes it explicitly.
input/fineco_raw/
# Timestamped backups created by scripts/preprocess_orders.py
input/*.bak.*
build.log
analyzer.log
# Per-run reports live under output/<YYYY-MM-DD>/<attempt-id>/ (already
# covered by output/* above); flat legacy paths remain ignored for older runs.
output/report.html
output/*/report.html

# Personal inputs are NEVER committed — even to a private repo. The
# automation pulls them from the configured Google Drive folder through
# tarzan/delivery/drive_loader.py at workflow runtime.
.private/

# Per-holding rebalancing targets (personal data, joined by ISIN to the
# order-derived holdings).
input/targets_per_holding.csv

# Local immutable market-data cache (default location is ~/.cache/tarzan,
# outside the repo; this guards the TARZAN_CACHE_DIR override landing here).
.cache/
tarzan_cache/

# TBTF analysis — raw corpus pulled from Arctic Shift (third-party archive).
# Personal/educational use only, NOT for redistribution. Regenerate locally
# with tbtf-analisi/fetch_arcticshift.py. Derived stats (small JSON) are kept.
tbtf-analisi/tbtf_arcticshift.json
