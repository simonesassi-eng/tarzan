{# ─── HOLDINGS (grouped by class + role, unified table) ────── #}
{# Kept in a partial so section ordering stays explicit. The table is
   pre-rendered by newsletter/_sections_alloc.py::_build_holdings through the
   shared unified-table renderer used by Returns, Performance, Risk, and the
   Optimizer.

   The per-class chip row that used to sit here is gone: it carried an
   instrument count per asset class, and the table below it is already grouped
   by asset class, so the counts were a caption on rows the reader can see. The
   subtitle carries the one figure the chips did not state — the total. #}
          {% if holdings.table_html %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "The book") }}
              {% if holdings.chips_html %}<div style="margin-top:8px;">{{ holdings.chips_html|safe }}</div>{% endif %}
              {{ holdings.table_html|safe }}
            </td>
          </tr>
          {% endif %}
