{# [01] STATE — the figures the rest of the issue elaborates on.
   Three rows of three: what the portfolio is worth and the profit in it, then
   the three return measures, then the context each is judged against. Each tile
   carries its own one-line caption; the definitions live in the appendix.

   The value chart and the cash-flow chips used to sit in this block. They moved
   to [02] PORTFOLIO, next to the window matrix, because a chart of the value
   over time and a table of returns over windows answer the same question and
   belong under one heading. #}
          <tr>
            <td class="px-32" style="padding:20px 32px 0 32px;">
              {{ sec(secn, "State") }}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-radius:12px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:16px 18px;">
                    {# Optional tiles are absent from hero.tiles rather than
                       blank, and the grid closes the row it is on, so a short
                       list never leaves an empty box. #}
                    {% for row in hero.tiles|batch(3) %}
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"{% if not loop.first %} style="margin-top:14px;"{% endif %}>
                      <tr>
                        {% for t in row %}
                        <td class="kpi-cell" width="33%" style="vertical-align:top;padding-right:10px;">
                          <div style="font-size:9px;font-weight:700;letter-spacing:0.09em;color:{{ palette.muted }};text-transform:uppercase;">{{ t.label }}</div>
                          <div style="margin-top:3px;font-size:22px;font-weight:700;line-height:1.1;color:{% if t.tone == 'pos' %}{{ palette.green }}{% elif t.tone == 'neg' %}{{ palette.red }}{% else %}{{ palette.ink }}{% endif %};">{{ t.value }}</div>
                          <div style="margin-top:2px;font-size:10px;color:{{ palette.muted }};line-height:1.4;">{{ t.caption }}</div>
                        </td>
                        {% endfor %}
                        {% for _ in range(3 - row|length) %}
                        <td width="33%">&nbsp;</td>
                        {% endfor %}
                      </tr>
                    </table>
                    {% endfor %}
                  </td>
                </tr>
              </table>

              {# Data-quality note: current snapshot provenance is kept
                 separate from historical order-price reconstruction. #}
              {% if performance.returns %}
              <div style="margin-top:10px;font-size:10px;color:{{ palette.subtle }};line-height:1.5;">
                {% if performance.returns.current_fallback_count %}
                Current portfolio: {{ performance.returns.current_fallback_count }} identifier{{ 's' if performance.returns.current_fallback_count != 1 else '' }} priced by order-price fallback.
                {% else %}
                Current portfolio: 100% market-priced.
                {% endif %}
                {% if performance.returns.historical_closed_fallback_count %} Historical reconstruction used order-price fallback for {{ performance.returns.historical_closed_fallback_count }} closed identifier{{ 's' if performance.returns.historical_closed_fallback_count != 1 else '' }}.{% endif %}
                {% if performance.returns.excluded_count %} {{ performance.returns.excluded_count }} historical identifier{{ 's' if performance.returns.excluded_count != 1 else '' }} excluded from return reconstruction.{% endif %}
                {% if performance.returns.coverage %} Return-series coverage: {{ performance.returns.coverage }}.{% endif %}
              </div>
              {% endif %}

              {# Slim, colored rebalance banner (only when action is needed). #}
              {% if hero.rebal_label and hero.rebal_label != 'Aligned' %}
              <div style="margin-top:10px;padding:7px 12px;background:{{ hero.rebal_bg }};border-radius:8px;font-size:11px;font-weight:700;color:{{ hero.rebal_color }};">
                {% if hero.rebal_label == 'Not executable' %}
                ● Rebalance · not executable · cash funding must be resolved before trading
                {% elif hero.rebal_label == 'Infeasible' %}
                ● Rebalance · no feasible plan
                {% else %}
                ● Rebalance · {{ hero.rebal_n_actions }} action{{ 's' if hero.rebal_n_actions != 1 else '' }} · see optimizer below
                {% endif %}
              </div>
              {% endif %}
            </td>
          </tr>
