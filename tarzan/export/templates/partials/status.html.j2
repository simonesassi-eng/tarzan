{# [01] STATE — the balance line and the four ledger cells.
   The portfolio value at display size with the session pill beside it (return,
   euros, which session); invested capital top right; then, under a double rule,
   Total P&L and Unrealized P&L over TWR and MWR, each cell a headline figure
   with its twin beneath. The nine tiles this replaces said the same things
   across three rows and repeated the masthead's status bar.
   Tones are verdicts by sign: green up, red down, ink for a figure with no
   sign to judge. The session cell carries the engine's proof as data-
   attributes, as the old tile did. #}
          {% set st = hero.state %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("State") }}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;"><tr>
                <td style="{{ type.label }}color:{{ palette.muted }};white-space:nowrap;">Portfolio value{% if st.days %} · {{ st.days }} days{% endif %}</td>
                <td align="right" style="{{ type.prose }}color:{{ palette.muted }};white-space:nowrap;font-variant-numeric:tabular-nums;"><b style="color:{{ palette.ink }};">{{ st.invested }}</b> invested</td>
              </tr></table>
              {# The session evidence element wraps the pill; its caption stands in
                 the Appendix and the semantic gate pairs the two. #}
              <div{% if st.session %} data-tarzan-session-move="true"{% if st.session.proof %} data-tarzan-session-availability="{{ st.session.proof.availability }}" data-tarzan-session-return="{{ st.session.proof.percent }}" data-tarzan-session-profit="{{ st.session.proof.profit }}" data-tarzan-session-basis="{{ st.session.proof.basis }}" data-tarzan-session-anchor="{{ st.session.proof.anchor }}" data-tarzan-session-end="{{ st.session.proof.end }}" data-tarzan-session-source-anchor="{{ st.session.proof.source_anchor }}" data-tarzan-session-source-end="{{ st.session.proof.source_end }}"{% endif %}{% endif %}>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:2px;"><tr>
                <td style="{{ type.display }}color:{{ palette.ink }};white-space:nowrap;font-variant-numeric:tabular-nums;vertical-align:middle;">{{ st.value }}</td>
                {% if st.session %}
                {% set sc = sign_color(st.session.tone) %}
                {% set sbg = palette.green_bg if st.session.tone == 'pos' else palette.red_bg if st.session.tone == 'neg' else palette.accent_bg %}
                <td style="padding-left:10px;vertical-align:middle;">
                  <span style="display:inline-block;padding:3px 9px;border-radius:999px;background:{{ sbg }};color:{{ sc }};font-size:12.5px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums;"><span data-tarzan-session-percent="true">{{ st.session.pct }}</span>{% if st.session.eur %} <span style="font-weight:400;">· {{ st.session.eur }}</span>{% endif %}{% if st.session.day %} <span style="font-weight:400;">· {{ st.session.day }}</span>{% endif %}</span>
                </td>
                {% endif %}
              </tr></table>
              </div>
              {# The session's proof line (euros to the cent, basis, window) is in
                 the Appendix: the owner wants State to carry the pill alone. #}
              {# The four ledger cells. ``table-layout:fixed`` with two 50%
                 columns: the grid holds at any width. #}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;border-top:3px double {{ palette.border }};table-layout:fixed;">
                <tr>
                  {% for cell in [
                    {"label": "Total P&L", "value": st.pnl.eur or st.pnl.pct, "tone": st.pnl.tone, "sub_fig": (st.pnl.pct if st.pnl.eur else None), "sub": st.pnl.caption},
                    {"label": "Unrealized P&L", "value": st.unrealized.eur or st.unrealized.pct, "tone": st.unrealized.tone, "sub_fig": (st.unrealized.pct if st.unrealized.eur else None), "sub": st.unrealized.caption},
                  ] %}
                  <td width="50%" style="width:50%;padding:8px {{ '14px' if loop.first else '0' }} 7px {{ '0' if loop.first else '14px' }};border-bottom:1px solid {{ palette.row_rule }};vertical-align:top;">
                    <div style="{{ type.label }}color:{{ palette.muted }};">{{ cell.label }}</div>
                    <div style="margin-top:2px;{{ type.figure }}color:{{ sign_color(cell.tone) }};white-space:nowrap;font-variant-numeric:tabular-nums;">{{ cell.value or "—" }}</div>
                    <div style="margin-top:2px;{{ type.note }}color:{{ palette.muted }};font-variant-numeric:tabular-nums;">{% if cell.sub_fig %}<span style="color:{{ sign_color(cell.tone) }};">{{ cell.sub_fig }}</span> {% endif %}{{ cell.sub }}</div>
                  </td>
                  {% endfor %}
                </tr>
                <tr>
                  <td width="50%" style="width:50%;padding:8px 14px 7px 0;border-bottom:1px solid {{ palette.row_rule }};vertical-align:top;">
                    {% if st.twr %}
                    <div style="{{ type.label }}color:{{ palette.muted }};">TWR · since inception</div>
                    <div style="margin-top:2px;{{ type.figure }}color:{{ sign_color(st.twr.tone) }};white-space:nowrap;font-variant-numeric:tabular-nums;">{{ st.twr.si }}</div>
                    <div style="margin-top:2px;{{ type.note }}color:{{ palette.muted }};font-variant-numeric:tabular-nums;">{% if st.twr.ann %}<span style="color:{{ sign_color(st.twr.tone) }};">{{ st.twr.ann }}</span> annualized{% elif st.twr.cagr %}<span style="color:{{ sign_color(st.twr.tone) }};">{{ st.twr.cagr }}</span> CAGR{% else %}time-weighted{% endif %}</div>
                    {% else %}&nbsp;{% endif %}
                  </td>
                  <td width="50%" style="width:50%;padding:8px 0 7px 14px;border-bottom:1px solid {{ palette.row_rule }};vertical-align:top;">
                    {% if st.mwr %}
                    <div style="{{ type.label }}color:{{ palette.muted }};">MWR · since inception</div>
                    <div style="margin-top:2px;{{ type.figure }}color:{{ sign_color(st.mwr.tone) }};white-space:nowrap;font-variant-numeric:tabular-nums;">{{ st.mwr.si }}</div>
                    <div style="margin-top:2px;{{ type.note }}color:{{ palette.muted }};font-variant-numeric:tabular-nums;">{% if st.mwr.ann %}<span style="color:{{ sign_color(st.mwr.tone) }};">{{ st.mwr.ann }}</span> annualized{% endif %}{% if st.mwr.net %} · <span style="white-space:nowrap;">{{ st.mwr.net }} net of tax</span>{% endif %}</div>
                    {% else %}&nbsp;{% endif %}
                  </td>
                </tr>
              </table>
              {# The engine's disclosures on what the figures rest on, one block:
                 the return basis, then the pricing provenance of the snapshot,
                 kept separate from historical order-price reconstruction. #}
              {# The return-basis disclosure (transfers, carrying prices) is in the
                 Appendix beside the session proof: State keeps the figures. #}
              {% if performance.returns %}
              <div style="margin-top:6px;{{ type.note }}color:{{ palette.muted }};">
                {% if performance.returns %}
                {% if performance.returns.current_fallback_count %}Current portfolio: {{ performance.returns.current_fallback_count }} identifier{{ 's' if performance.returns.current_fallback_count != 1 else '' }} priced by order-price fallback.{% else %}Current portfolio: 100% market-priced.{% endif %}
                {% if performance.returns.historical_closed_fallback_count %} Historical reconstruction used order-price fallback for {{ performance.returns.historical_closed_fallback_count }} closed identifier{{ 's' if performance.returns.historical_closed_fallback_count != 1 else '' }}.{% endif %}
                {% if performance.returns.excluded_count %} {{ performance.returns.excluded_count }} historical identifier{{ 's' if performance.returns.excluded_count != 1 else '' }} excluded from return reconstruction.{% endif %}
                {% if performance.returns.coverage %} Return-series coverage: {{ performance.returns.coverage }}.{% endif %}
                {% endif %}
              </div>
              {% endif %}
            </td>
          </tr>
