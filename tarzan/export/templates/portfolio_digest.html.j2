{# =============================================================================
   Tarzan — Portfolio Digest (email-safe HTML, Jinja2 template)
   =============================================================================

   Context shape (see tarzan/export/newsletter.py::build_context):
     palette          dict of CSS hex colors
     header           {date_short, issue_number, inception_date}
     hero             {total_value, total_pnl_eur, total_pnl_pct,
                       total_pnl_is_positive, unrealized_eur,
                       unrealized_pct, unrealized_is_positive,
                       has_total_pnl, inception_label, gain_pct, twror_pct,
                       twror_is_positive, invested_value, invested_pct,
                       cash_value, cash_msg, cash_msg_color,
                       week_pnl_eur, week_pnl_pct, week_pnl_is_positive,
                       week_twror_pct, week_twror_is_positive}
     ai_summary       optional AI-generated market-context note (string);
                      renders below the Performance section (the only
                      market-context surface — there is no rule-based fallback)
     movers           {available, best, worst, benchmark_name}
     allocation       {rows[], stacked[], tolerance}  (consumed internally by
                      diversification; not referenced directly in the template)
     geography        {rows[], stacked[], benchmark_name}  (ditto)
     diversification  {available, html} — pre-rendered tile dashboard
                      (asset class + geography + by-holding), injected as
                      safe HTML; see newsletter.py::_build_diversification
     holdings         {groups[], summary[], total_count}
     performance      {portfolio_row, benchmark_rows[],
                       benchmark_alpha_beta, benchmark_geo}
     risk_profile     {available, headers[], rows[],
                       benchmark_alpha_beta, benchmark_geo}
     optimizer        {available, direction, name, ticker, ...}
     return_contrib   {winners[], laggards[]}
     methodology      {available, html} — actual return-window spans, at the bottom
     tax_note         {available, html} — net-of-tax estimate, rendered at
                      the very bottom (above the footer)
     preheader        str
     footer           {generated_at, version}

   All values are pre-formatted strings so the template is purely presentational.
============================================================================= #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Tarzan — Portfolio Digest</title>
  <style>
    body { margin: 0; padding: 0; background: {{ palette.page }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, Helvetica, Arial, sans-serif; }
    table { border-collapse: collapse; }
    img { display: block; border: 0; }
    a { color: {{ palette.accent }}; text-decoration: none; }
    @media only screen and (max-width: 620px) {
      .container { width: 100% !important; }
      .kpi-cell  { display: block !important; width: 100% !important; box-sizing: border-box; }
      .px-32     { padding-left: 20px !important; padding-right: 20px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:{{ palette.page }};font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Inter',Roboto,Helvetica,Arial,sans-serif;color:{{ palette.ink }};">

  {# -- Preheader (hidden, shown as preview text in inbox) -- #}
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ palette.page }};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,0.06);">

          {# ─── HEADER ───────────────────────────────────────── #}
          <tr>
            <td class="px-32" style="padding:28px 32px 20px 32px;background:#FFFFFF;border-bottom:1px solid {{ palette.border }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" style="vertical-align:middle;">
                    <div style="font-size:14px;font-weight:700;letter-spacing:0.04em;color:{{ palette.accent }};text-transform:uppercase;">🌿&nbsp;Tarzan</div>
                    <div style="margin-top:4px;font-size:22px;font-weight:700;color:{{ palette.ink }};line-height:1.2;">Portfolio Digest</div>
                  </td>
                  <td align="right" style="vertical-align:middle;font-size:12px;color:{{ palette.muted }};line-height:1.4;">
                    <div>{{ header.date_short }}</div>
                    <div>Issue #{{ header.issue_number }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {# ─── STATUS ─────────────────────────────────────── #}
          {# Chart-led hero + Profit&Losses / TWROR scoreboard + annualized
             cards + slim rebalance banner. See partials/status.html.j2. #}
          {% include "partials/status.html.j2" %}


          {# ─── PERFORMANCE (1D/7D/30D/since matrix + 30-day charts) ─────────
             Owns the multi-horizon P&L / TWROR numbers and the recent
             trajectory. The hero above is now a slim lifetime-state band so
             no figure appears twice. SVG charts render in Gmail/Apple Mail;
             legacy Outlook shows the matrix + chips (PNG fallback is a TODO).
             Pre-rendered in newsletter.py::_build_performance30 (SVG can't be
             expressed in Jinja), injected as safe HTML. #}
          {% if performance30.available %}
          <tr>
            <td class="px-32" style="padding:28px 32px 0 32px;">
              {{ performance30.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── MARKETS (yfinance-style index strip) ─────────────
             Major indices with level, daily change and a mini sparkline,
             from the already-fetched benchmark histories. Sits above the
             AI market-context note so the data backs the narrative. #}
          {% if markets.available %}
          <tr>
            <td class="px-32" style="padding:28px 32px 0 32px;">
              {{ markets.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── MARKET CONTEXT (AI) ─────────────────────────────
             Macro recap of the last 24-48h tied to the portfolio's
             exposures, grounded via Google Search. Renders directly below
             the "How your money moved" charts. When unavailable (no API key)
             no market-context block is shown. #}
          {% if ai_summary %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              <div style="font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">Market context</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-left:4px solid {{ palette.accent }};border-radius:8px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:14px 16px;">
                    <div style="font-size:13.5px;color:{{ palette.ink }};line-height:1.55;">{{ ai_summary_html|safe }}</div>
                    <div style="margin-top:8px;font-size:10px;color:{{ palette.subtle }};">✨ AI-generated market context · news may be imperfect · not financial advice</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}


          {# ─── DIVERSIFICATION (tile dashboard: asset class + geography +
             by holding) — pre-rendered in newsletter.py::_build_diversification
             (SVG donut gauges + 1-month trend sparklines can't be expressed in
             Jinja), injected as safe HTML. Each tile shows the actual weight, a
             donut gauge whose fill is that weight with an ink notch at the
             target, a drift pill, and a last-month trend vs target. ── #}
          {% if diversification.available %}
          <tr>
            <td class="px-32" style="padding:28px 32px 0 32px;">
              {{ diversification.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── RETURNS SNAPSHOT (per-holding × period) ─────── #}
          {% if returns_snapshot.available %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              <div style="font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">Returns snapshot</div>
              <div style="margin-top:4px;font-size:12px;color:{{ palette.muted }};">Portfolio vs {{ returns_snapshot.benchmark_alpha_beta }}: <span style="color:{{ palette.green }};font-weight:700;">●</span> beat · <span style="color:{{ palette.amber }};font-weight:700;">●</span> in line · <span style="color:{{ palette.red }};font-weight:700;">●</span> under</div>
              {{ returns_snapshot.table_html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── PERFORMANCE — RETURNS BY ASSET CLASS & ROLE ──────
             Sectioned table (asset class · role) with a 1D intraday
             sparkline. Pre-rendered in newsletter.py::_build_performance
             (SVG sparklines + grouping can't be expressed in Jinja),
             injected as safe HTML — same pattern as Markets. #}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              <div style="font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">{{ performance.kicker }}</div>
              <div style="margin-top:4px;font-size:12px;color:{{ palette.muted }};">{{ performance.subtitle_html|safe }}</div>
              {{ performance.table_html|safe }}
            </td>
          </tr>

          {# ─── RISK PROFILE — UNIFIED TABLE ────────────────── #}
          {% if risk_profile.available %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              <div style="font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">{{ risk_profile.title }}</div>
              {% if risk_profile.portfolio_note %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:9px 12px;background:{{ palette.accent_bg }};border:1px solid {{ palette.border }};border-left:4px solid {{ palette.accent }};border-radius:8px;font-size:11px;color:{{ palette.ink }};line-height:1.5;">&#9432; {{ risk_profile.portfolio_note }}</td>
                </tr>
              </table>
              {% endif %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;font-size:11px;border-collapse:separate;border-spacing:0;">
                {# Header row: empty corner + metric columns #}
                <tr>
                  <td style="padding:8px 8px;background:{{ palette.ink }};color:#FFFFFF;font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;border-top-left-radius:8px;">Series</td>
                  {% for c in risk_profile.columns %}
                  <td align="right" style="padding:8px 5px;background:{{ palette.ink }};color:#FFFFFF;font-size:10px;font-weight:700;{% if loop.last %}border-top-right-radius:8px;{% endif %}">{{ c.label }}{{ c.note }}</td>
                  {% endfor %}
                </tr>
                {% for r in risk_profile.rows %}
                {% set outer_last = loop.last %}
                {% set row_bg = '#FFFFFF' if loop.index is odd else palette.card_alt %}
                {% if r.group_header %}
                {# Group separator row (asset class · role) — same style as Performance/Returns. #}
                <tr>
                  <td colspan="{{ risk_profile.columns|length + 1 }}" style="padding:8px 8px 4px;border-bottom:1px solid {{ palette.border }};font-size:10px;font-weight:700;color:{{ palette.muted }};letter-spacing:0.02em;"><span style="display:inline-block;width:8px;height:8px;background:{{ r.group_color }};border-radius:2px;vertical-align:middle;margin-right:6px;"></span><span style="color:{{ r.group_color }};font-weight:800;text-transform:uppercase;">{{ r.group_header[0] }}</span>{% if r.group_header[1] %}&nbsp;&middot;&nbsp;{{ r.group_header[1] }}{% endif %}</td>
                </tr>
                {% endif %}
                {% if r.is_portfolio %}
                {# Portfolio row — highlighted, same style as Performance. #}
                <tr>
                  <td style="padding:10px 8px;background:{{ palette.accent_bg }};color:{{ palette.accent }};font-weight:700;font-size:12px;{% if outer_last %}border-bottom-left-radius:8px;{% endif %}">★ {{ r.label }}{% if r.span_label %}<span style="display:inline-block;margin-left:6px;font-size:9px;font-weight:700;color:{{ palette.accent }};opacity:0.75;vertical-align:middle;">{{ r.span_label }}</span>{% endif %}</td>
                  {% for c in r.cells %}
                  <td align="right" style="padding:10px 5px;background:{{ palette.accent_bg }};font-variant-numeric:tabular-nums;color:{{ palette.ink }};font-weight:700;{% if outer_last and loop.last %}border-bottom-right-radius:8px;{% endif %}">{{ c }}</td>
                  {% endfor %}
                </tr>
                {% else %}
                <tr>
                  <td style="padding:9px 8px;background:{{ row_bg }};{% if not outer_last %}border-bottom:1px solid #F1F2F8;{% endif %}color:{{ palette.ink }};font-weight:600;{% if outer_last %}border-bottom-left-radius:8px;{% endif %}">{{ r.label }}{% if r.ticker %}<span style="display:inline-block;margin-left:5px;padding:1px 5px;background:{{ palette.page }};color:{{ palette.muted }};border:1px solid {{ palette.border }};border-radius:4px;font-size:9px;font-weight:700;font-family:SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:0.02em;vertical-align:middle;">{{ r.ticker }}</span>{% endif %}{% for t in r.tags %}<span style="display:inline-block;margin-left:4px;padding:1px 6px;background:{{ t[2] }};color:{{ t[1] }};border-radius:4px;font-size:9px;font-weight:700;letter-spacing:0.04em;vertical-align:middle;">{{ t[0] }}</span>{% endfor %}{% if r.span_label %}<span style="display:inline-block;margin-left:6px;font-size:9px;font-weight:600;color:{{ palette.subtle }};vertical-align:middle;">{{ r.span_label }}</span>{% endif %}</td>
                  {% for c in r.cells %}
                  <td align="right" style="padding:9px 5px;background:{{ row_bg }};font-variant-numeric:tabular-nums;color:{{ palette.muted }};{% if not outer_last %}border-bottom:1px solid #F1F2F8;{% endif %}{% if outer_last and loop.last %}border-bottom-right-radius:8px;{% endif %}">{{ c }}</td>
                  {% endfor %}
                </tr>
                {% endif %}
                {% endfor %}
              </table>
              {% if risk_profile.alpha_beta_note %}
              <div style="margin-top:6px;font-size:10px;color:{{ palette.subtle }};">* {{ risk_profile.alpha_beta_note }}</div>
              {% endif %}

              {# Legend — same content as the Excel Performance tab Legend #}
              {% if risk_profile.legend %}
              <div style="margin-top:20px;font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">Legend</div>
              <div style="margin-top:2px;font-size:11px;color:{{ palette.muted }};">Bands next to each metric: <span style="color:{{ palette.green }};font-weight:700;">strong</span> &middot; <span style="color:{{ palette.amber }};font-weight:700;">fair</span> &middot; <span style="color:{{ palette.red }};font-weight:700;">weak</span>.</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;border-collapse:separate;border-spacing:6px;">
                {% for r in risk_profile.legend %}
                {% if loop.index0 % 2 == 0 %}<tr>{% endif %}
                <td width="50%" valign="top" style="padding:8px 10px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-radius:9px;">
                  <div style="line-height:1.6;">
                    <span style="font-size:12px;font-weight:700;color:{{ palette.ink }};">{{ r.label }}</span><span style="display:inline-block;margin-left:3px;padding:0 5px;border-radius:4px;background:{{ palette.green_bg }};color:{{ palette.green }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.strong }}</span><span style="display:inline-block;margin-left:3px;padding:0 5px;border-radius:4px;background:{{ palette.amber_bg }};color:{{ palette.amber }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.fair }}</span><span style="display:inline-block;margin-left:3px;padding:0 5px;border-radius:4px;background:{{ palette.red_bg }};color:{{ palette.red }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.weak }}</span>
                  </div>
                  <div style="margin-top:3px;font-size:10px;line-height:1.45;color:{{ palette.muted }};">{{ r.description }}</div>
                </td>
                {% if loop.index0 % 2 == 1 or loop.last %}</tr>{% endif %}
                {% endfor %}
              </table>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── HOLDINGS (All positions) — rendered after Risk profile. #}
          {% include "partials/holdings.html.j2" %}

          {# ─── RETURN CONTRIBUTION — ranked diverging bars ──────── #}
          {% if return_contrib.winners or return_contrib.laggards %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              <div style="font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">Return contribution</div>

              {% if return_contrib.winners %}
              <div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.green }};text-transform:uppercase;">▲ Top contributors</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;font-size:12px;">
                {% for w in return_contrib.winners %}
                <tr>
                  <td width="42%" style="padding:5px 8px 5px 0;color:{{ palette.ink }};vertical-align:middle;">{{ w.name|truncate(26, true, '…') }}</td>
                  <td style="padding:5px 0;vertical-align:middle;">
                    <div style="background:{{ palette.green_bg }};border-radius:4px;font-size:0;line-height:0;">
                      <div style="height:9px;width:{{ w.bar_pct }}%;min-width:2px;background:{{ palette.green }};border-radius:4px;font-size:0;line-height:0;">&nbsp;</div>
                    </div>
                  </td>
                  <td width="64" align="right" style="padding:5px 0 5px 10px;font-weight:700;color:{{ palette.green }};font-variant-numeric:tabular-nums;vertical-align:middle;">{{ w.value }}</td>
                </tr>
                {% endfor %}
              </table>
              {% endif %}

              {% if return_contrib.laggards %}
              <div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.red }};text-transform:uppercase;">▼ Laggards</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;font-size:12px;">
                {% for l in return_contrib.laggards %}
                <tr>
                  <td width="42%" style="padding:5px 8px 5px 0;color:{{ palette.ink }};vertical-align:middle;">{{ l.name|truncate(26, true, '…') }}</td>
                  <td style="padding:5px 0;vertical-align:middle;">
                    <div style="background:{{ palette.red_bg }};border-radius:4px;font-size:0;line-height:0;">
                      <div style="height:9px;width:{{ l.bar_pct }}%;min-width:2px;background:{{ palette.red }};border-radius:4px;font-size:0;line-height:0;">&nbsp;</div>
                    </div>
                  </td>
                  <td width="64" align="right" style="padding:5px 0 5px 10px;font-weight:700;color:{{ palette.red }};font-variant-numeric:tabular-nums;vertical-align:middle;">{{ l.value }}</td>
                </tr>
                {% endfor %}
              </table>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── OPTIMIZER ACTION (two plans: buy-only vs buy & sell) ─── #}
          {% if optimizer.available %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              <div style="font-size:13px;font-weight:700;letter-spacing:0.08em;color:{{ palette.accent }};text-transform:uppercase;">Optimizer</div>
              {% for plan in optimizer.plans %}
              <div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.accent }};text-transform:uppercase;">{{ plan.label }}</div>
              <div style="margin-top:2px;font-size:12px;color:{{ palette.muted }};">
                {{ plan.n_buy }} BUY &nbsp;·&nbsp; {{ plan.n_sell }} SELL &nbsp;·&nbsp; total
                <span style="color:{{ palette.green }};font-weight:600;">{{ plan.total_buy }}</span> in,
                <span style="color:{{ palette.red }};font-weight:600;">{{ plan.total_sell }}</span> out,
                net <span style="color:{{ plan.net_color }};font-weight:600;">{{ plan.net }}</span>
              </div>
              {% if plan.actions %}
              {# Same table style as Diversification "By holding": card_alt
                 container, light uppercase header, per-row border, ticker pin. #}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;font-size:12px;border-collapse:separate;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-radius:10px;overflow:hidden;">
                <tr>
                  <td style="padding:4px 8px;font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:{{ palette.subtle }};width:56px;">Action</td>
                  <td style="padding:4px 8px;font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:{{ palette.subtle }};">Holding</td>
                  <td style="padding:4px 8px;font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:{{ palette.subtle }};width:92px;">Asset</td>
                  <td align="right" style="padding:4px 8px;font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:{{ palette.subtle }};width:92px;">Amount</td>
                </tr>
                {% for a in plan.actions %}
                <tr>
                  <td style="padding:6px 8px;border-bottom:1px solid {{ palette.border }};vertical-align:top;">
                    <span style="display:inline-block;padding:2px 7px;background:{{ a.direction_bg }};color:{{ a.direction_color }};border-radius:999px;font-weight:700;font-size:10px;letter-spacing:0.04em;">{{ a.direction }}</span>
                  </td>
                  <td style="padding:6px 8px;border-bottom:1px solid {{ palette.border }};vertical-align:top;color:{{ palette.ink }};">
                    <div style="font-size:12px;line-height:1.3;">{% if a.ticker %}<span style="display:inline-block;margin-right:5px;padding:1px 5px;background:{{ palette.page }};color:{{ palette.muted }};border:1px solid {{ palette.border }};border-radius:4px;font-size:9px;font-weight:700;font-family:SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:0.02em;vertical-align:middle;">{{ a.ticker }}</span>{% endif %}{{ a.name }}</div>
                    {% if a.reason %}
                    <div style="margin-top:3px;font-size:10px;color:{{ palette.subtle }};line-height:1.45;">{{ a.reason }}</div>
                    {% endif %}
                  </td>
                  <td style="padding:6px 8px;border-bottom:1px solid {{ palette.border }};vertical-align:top;font-size:11px;font-weight:600;color:{{ a.asset_color }};">{{ a.asset_class }}</td>
                  <td align="right" style="padding:6px 8px;border-bottom:1px solid {{ palette.border }};vertical-align:top;font-variant-numeric:tabular-nums;font-weight:700;color:{{ a.direction_color }};">{{ a.amount }}</td>
                </tr>
                {% endfor %}
              </table>
              {% else %}
              <div style="margin-top:8px;padding:9px 12px;background:{{ palette.green_bg }};border:1px solid {{ palette.green_border }};border-radius:8px;font-size:12px;color:{{ palette.ink }};">Already on target — no trades needed.</div>
              {% endif %}
              {% endfor %}
            </td>
          </tr>
          {% endif %}

          {# ─── NET-OF-TAX NOTE (estimate) — moved to the very bottom so it
             does not crowd the Performance headline numbers. ── #}
          {% if tax_note.available %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              {{ tax_note.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── METHODOLOGY (actual return-window spans) ───── #}
          {% if methodology.available %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              {{ methodology.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── FOOTER ────────────────────────────────────── #}
          <tr>
            <td class="px-32" style="padding:24px 32px 32px 32px;border-top:1px solid {{ palette.border }};">
              <div style="font-size:11px;color:{{ palette.muted }};line-height:1.6;text-align:center;">
                Generated {{ footer.generated_at }} · Tarzan {{ footer.version }}<br>
                {{ holdings.total_count }} holdings tracked · also exported as Excel report<br>
                Personal portfolio analytics. Not investment advice.
              </div>
            </td>
          </tr>

        </table>
        <div style="margin-top:14px;font-size:11px;color:{{ palette.subtle }};">🌿 Tarzan — Built for the long swing.</div>
      </td>
    </tr>
  </table>
</body>
</html>
