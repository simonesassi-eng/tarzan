{# =============================================================================
   Tarzan — Portfolio Digest (email-safe HTML, Jinja2 template)
   =============================================================================

   Context authority: tarzan.export.newsletter.build_context.

   The context contains palette/header/hero data plus the preformatted
   performance, market, diversification, holdings, risk, optimizer,
   contribution, tax, and methodology sections consumed below. Section HTML
   is built by the focused newsletter modules before template rendering.

   Display values are preformatted; section mappings remain structured so the
   template can control availability and layout without recomputing analytics.
============================================================================= #}
{# One definition for every section kicker: a running ordinal in accent, then
   the label. The counter lives in a namespace and is incremented HERE, so it
   numbers the sections actually rendered. A static number per section left
   holes in the sequence whenever an optional block (market context, optimizer)
   was unavailable. #}
{% macro sec(ns, label, sub=None) -%}
{%- set ns.n = ns.n + 1 -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td align="left" style="white-space:nowrap;"><span style="font-size:10px;font-weight:700;color:{{ palette.accent }};">[{{ "%02d"|format(ns.n) }}]</span>&nbsp;&nbsp;<span style="font-size:12.5px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:{{ palette.ink }};">{{ label }}</span></td>
{# The rule fills whatever the label leaves, so the heading reads as a ruled
   band across the column instead of a floating word. #}
<td width="100%" style="padding-left:12px;"><div style="height:1px;background:{{ palette.border }};font-size:0;line-height:0;">&nbsp;</div></td>
</tr></table>
{%- if sub %}<div style="margin-top:7px;font-size:11px;line-height:1.6;color:{{ palette.muted }};">{{ sub|safe }}</div>{% endif -%}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# The palette is dark, so declare it: a client told "light" may auto-invert
     a dark document and produce colours nobody chose. #}
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>Tarzan Portfolio Digest</title>
  <style>
    {# Apple Mail (and iOS WebKit) auto-inflate text in a table cell that has no
       intrinsic width. Fixed table layout plus an explicit CSS width on every
       STATE tile cell (below, in status.html.j2) keeps the declared columns
       authoritative regardless, so inflated glyphs wrap or clip inside their
       own tile instead of overflowing the row. Pin the adjustment off too, so
       the declared sizes are the rendered ones and nothing needs to wrap. #}
    body, table, td, div, span { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; text-size-adjust: 100%; }
    body { margin: 0; padding: 0; background: {{ palette.page }}; font-family: ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace; }
    table { border-collapse: collapse; }
    img { display: block; border: 0; }
    a { color: {{ palette.accent }}; text-decoration: none; }
    {# Reflow the frame as soon as the window is narrower than the card. #}
    @media only screen and (max-width: 620px) {
      .container { width: 100% !important; }
      .px-32     { padding-left: 18px !important; padding-right: 18px !important; }
    }
    {# The STATE tiles used to collapse to one column below 520px — meant as
       a narrow-pane fallback, but every phone viewport is narrower than
       that, so the "grid" never actually rendered as a grid for its one
       reader: nine tiles, one per line, on every read. Three fixed 33.33%
       columns (status.html.j2) hold their structure at any width down to
       an iPhone SE — the widest tile value ("€234,579" at 22px monospace,
       ~120px) wraps to a second line inside its own cell on the narrowest
       phones rather than breaking the grid — so there is no width at which
       a further collapse is needed, hence no breakpoint here at all. #}
  </style>
</head>
{% set secn = namespace(n=0) %}
<body style="margin:0;padding:0;background:{{ palette.page }};font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;color:{{ palette.ink }};">

  {# -- Preheader (hidden, shown as preview text in inbox) -- #}
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ palette.page }};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" class="container" width="620" cellpadding="0" cellspacing="0" border="0" style="width:620px;max-width:620px;background:{{ palette.card }};border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,0.06);">

          {# ─── MASTHEAD + STATUS BAR ─────────────────────────────
             One block, not two. The wordmark and the data stamp on the first
             line, the figures a reader checks before deciding to read on the
             second. There is no "Portfolio Digest" title line: the document is
             the digest, and the line cost a third of the opening screen to
             restate the subject. The issue number lives in the footer, next to
             the version and the run stamp it belongs with.
             Built in _sections_alloc.py::_build_header; entries the engine
             cannot supply are absent, not blank. #}
          <tr>
            <td class="px-32" style="padding:11px 20px 9px 20px;background:{{ palette.page }};border-bottom:1px solid {{ palette.border }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" style="white-space:nowrap;"><span style="font-size:11px;font-weight:700;letter-spacing:0.22em;color:{{ palette.accent }};">TARZAN</span></td>
                  <td align="right" style="font-size:10px;color:{{ palette.subtle }};white-space:nowrap;">{{ header.stamp }}</td>
                </tr>
              </table>
              {% if header.status_bar %}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:9px;">
                <tr>
                  {% for b in header.status_bar %}
                  <td style="padding:0 8px 0 0;white-space:nowrap;">
                    {# No text-transform: CSS uppercase maps the beta label to a
                       capital Beta, which renders as a plain "B". The labels are
                       already written in caps. #}<span style="font-size:8.5px;font-weight:700;letter-spacing:0.06em;color:{{ palette.subtle }};">{{ b.label }}</span>&nbsp;<span style="font-size:11px;font-weight:700;font-variant-numeric:tabular-nums;color:{% if b.tone == 'pos' %}{{ palette.green }}{% elif b.tone == 'neg' %}{{ palette.red }}{% else %}{{ palette.ink }}{% endif %};">{{ b.value }}</span>{% if not loop.last %}<span style="color:{{ palette.border }};padding-left:8px;">│</span>{% endif %}
                  </td>
                  {% endfor %}
                </tr>
              </table>
              {% endif %}
            </td>
          </tr>
          {# ═══ BODY ORDER ═══════════════════════════════════════════
             Twelve sections, each with one question:
               01 state        what the portfolio is
               02 portfolio    what it did, over time and by window
               03 vs the market whether that beat the alternative
               04 markets      what the market did, and why
               05 allocation   where the money sits vs where it should
               06 the book     the positions themselves
               07 returns      how each position performed
               08 watchlist    how the instruments not held performed
               09 attribution  which positions moved the number
               10 risk         what the shape of the ride was
               11 optimizer    what to do about it
               12 appendix      tax, method, feeds
             The ordinals come from the shared counter in sec(), so a section
             the engine cannot fill leaves no hole in the sequence. #}

          {# ─── [01] STATE ─────────────────────────────────── #}
          {% include "partials/status.html.j2" %}

          {# ─── [02] PORTFOLIO ──────────────────────────────
             The value chart with unrealized P&L on the right axis, then the
             same story by window. Pre-rendered in
             newsletter/_sections_perf.py::_build_performance30 and
             _sections_alloc.py::_build_hero — inline SVG cannot be expressed
             in Jinja. #}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Portfolio") }}
              {% if hero.value_chart %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-radius:12px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:14px 16px;">
                    {{ hero.value_chart|safe }}
                    {% if hero.value_chart_legend %}{{ hero.value_chart_legend|safe }}{% endif %}
                    {% if hero.flow_chips_html %}{{ hero.flow_chips_html|safe }}{% endif %}
                  </td>
                </tr>
              </table>
              {% endif %}
              {% if performance30.available %}{{ performance30.matrix_html|safe }}{% endif %}
            </td>
          </tr>

          {# ─── [03] VS THE MARKET ──────────────────────────
             Its own section rather than a card inside performance: whether the
             portfolio beat the alternative is a different question from what it
             returned, and the subtitle states the answer before the charts. #}
          {% if performance30.available and performance30.vs_market_html %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Vs the market", performance30.vs_market_sub) }}
              <div style="margin-top:12px;">{{ performance30.vs_market_html|safe }}</div>
            </td>
          </tr>
          {% endif %}

          {# ─── [04] MARKETS ────────────────────────────────
             Every index with its session path, level and change, in two
             columns split on a region boundary, then a short financial-news
             digest (last 6 hours + previous-session recap), grounded in
             Google Search — general market news, not portfolio commentary.
             One section: the digest reads as a coda to the table above it,
             and as a section of its own it claimed an ordinal for a handful
             of headlines. #}
          {% if markets.available or ai_summary %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Markets", markets.sub) }}
              {% if markets.available %}{{ markets.html|safe }}{% endif %}
              {% if ai_summary %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-left:4px solid {{ palette.accent }};border-radius:8px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:14px 16px;">
                    <ul style="margin:0;padding:0 0 0 16px;font-size:13.5px;color:{{ palette.ink }};line-height:1.55;">{{ ai_summary_html|safe }}</ul>
                    <div style="margin-top:8px;font-size:10px;color:{{ palette.subtle }};">✨ AI-generated news digest · via Google Search · not financial advice</div>
                  </td>
                </tr>
              </table>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── [05] ALLOCATION ─────────────────────────────
             Asset class, geography and per-holding targets: weight now, target,
             the weight against its target on a shared axis, the trend and the
             drift. Pre-rendered in _sections_alloc.py::_build_diversification. #}
          {% if diversification.available %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Allocation") }}
              {{ diversification.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── [06] THE BOOK ───────────────────────────────
             The positions, before the grids that dissect them: a reader meets
             the holdings, then their returns. #}
          {% include "partials/holdings.html.j2" %}

          {# ─── [07] RETURNS ────────────────────────────────
             Per-holding, session then every window to five years. #}
          {% if returns_snapshot.available %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {# No subtitle and no colour key. The grouping is visible in the
                 group header rows, the per-column scaling is what conditional
                 formatting means, and the beat/in-line/under key described the
                 portfolio row's three colours -- one row out of eighteen. #}
              {{ sec(secn, "Returns") }}
              {{ returns_snapshot.table_html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── [08] WATCHLIST ──────────────────────────────
             The same columns over the instruments tracked but not held, scaled
             on this table's own columns so it never borrows the book's range. #}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Watchlist", "Instruments tracked, not held. Same columns, scaled on this table's own columns.") }}
              {{ performance.table_html|safe }}
            </td>
          </tr>

          {# ─── [09] ATTRIBUTION — waterfall, then the two ranked lists ─ #}
          {% if return_contrib.winners or return_contrib.laggards %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {# No subtitle: the waterfall's connectors show that the bars add
                 up, and its own footnote states the measure. #}
              {{ sec(secn, "Attribution") }}
              {% if return_contrib.chart_html %}
              <div style="margin-top:12px;border:1px solid {{ palette.border }};border-radius:10px;overflow:hidden;">{{ return_contrib.chart_html|safe }}</div>
              {% endif %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;">
                <tr>
                  <td width="50%" valign="top" style="padding:0 9px 0 0;">
                    {% if return_contrib.winners %}
                    <div style="font-size:10px;font-weight:700;letter-spacing:0.06em;color:{{ palette.green }};text-transform:uppercase;">▲ Top contributors</div>
                    {% for w in return_contrib.winners %}
                    <div style="margin-top:6px;font-size:11px;color:{{ palette.ink }};">{{ w.name|truncate(26, true, '…') }}<b style="color:{{ palette.green }};float:right;font-variant-numeric:tabular-nums;">{{ w.value }}</b></div>
                    {% endfor %}
                    {% endif %}
                  </td>
                  <td width="50%" valign="top" style="padding:0 0 0 9px;border-left:1px solid {{ palette.border }};">
                    {% if return_contrib.laggards %}
                    <div style="font-size:10px;font-weight:700;letter-spacing:0.06em;color:{{ palette.red }};text-transform:uppercase;">▼ Laggards</div>
                    {% for l in return_contrib.laggards %}
                    <div style="margin-top:6px;font-size:11px;color:{{ palette.ink }};">{{ l.name|truncate(26, true, '…') }}<b style="color:{{ palette.red }};float:right;font-variant-numeric:tabular-nums;">{{ l.value }}</b></div>
                    {% endfor %}
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}
          {# ─── [10] RISK — after attribution and immediately before the
             optimizer, so the evidence precedes the action. #}
          {% if risk_profile.available %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Risk", risk_profile.subtitle) }}
              {% if risk_profile.portfolio_note %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:9px 12px;background:{{ palette.accent_bg }};border:1px solid {{ palette.border }};border-left:4px solid {{ palette.accent }};border-radius:8px;font-size:11px;color:{{ palette.ink }};line-height:1.5;">&#9432; {{ risk_profile.portfolio_note }}</td>
                </tr>
              </table>
              {% endif %}
              {# Ten tiles, five to a row: the figure and, where the
                 configuration rates the metric, a gauge putting it on its own
                 weak/fair/strong scale. This was a 36-row table -- the
                 portfolio plus every reference instrument -- which answered a
                 comparison nobody asked for at a quarter of the issue's
                 height. #}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;border-collapse:separate;border-spacing:0;">
                {% for row in risk_profile.tiles|batch(5) %}
                <tr>
                  {% for t in row %}
                  <td class="stack" width="20%" valign="top" style="padding:9px 10px;border:1px solid {{ palette.border }};background:{{ palette.card_alt }};">
                    <div style="font-size:9px;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:{{ palette.subtle }};">{{ t.label }}</div>
                    <div style="margin-top:2px;font-size:15px;font-weight:700;color:{{ palette.ink }};font-variant-numeric:tabular-nums;">{{ t.value }}</div>
                    {% if t.gauge %}<div style="margin-top:5px;">{{ t.gauge|safe }}</div>{% endif %}
                  </td>
                  {% endfor %}
                  {% for _ in range(5 - row|length) %}<td width="20%">&nbsp;</td>{% endfor %}
                </tr>
                {% endfor %}
              </table>
              {% if risk_profile.alpha_beta_note %}
              <div style="margin-top:6px;font-size:10px;color:{{ palette.subtle }};">* {{ risk_profile.alpha_beta_note }}</div>
              {% endif %}

              {% if risk_profile.legend %}
              {# The legend glosses the tiles above it, so it is a sub-block of
                 this section rather than a section of its own: an ordinal for a
                 glossary put it on the same footing as the risk figures.

                 One row per metric: name, its three bands, one clause of
                 definition. Ten boxed cards in two columns, each with a
                 three-line gloss, were taller than the ten tiles they
                 explained. #}
              <div style="margin-top:18px;font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.accent }};text-transform:uppercase;">Legend</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:6px;border-collapse:collapse;">
                <tr>
                  <td style="padding:0 8px 4px 0;font-size:9px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{ palette.muted }};">Metric</td>
                  <td style="padding:0 8px 4px 0;font-size:9px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{ palette.muted }};white-space:nowrap;"><span style="color:{{ palette.green }};">strong</span> &middot; <span style="color:{{ palette.amber }};">fair</span> &middot; <span style="color:{{ palette.red }};">weak</span></td>
                  <td style="padding:0 0 4px 0;font-size:9px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:{{ palette.muted }};">Reads as</td>
                </tr>
                {% for r in risk_profile.legend %}
                <tr>
                  <td valign="top" style="padding:3px 8px 3px 0;font-size:10.5px;font-weight:700;color:{{ palette.ink }};white-space:nowrap;{% if not loop.first %}border-top:1px solid {{ palette.border }};{% endif %}">{{ r.label }}</td>
                  <td valign="top" style="padding:3px 8px 3px 0;white-space:nowrap;{% if not loop.first %}border-top:1px solid {{ palette.border }};{% endif %}"><span style="display:inline-block;padding:0 4px;border-radius:3px;background:{{ palette.green_bg }};color:{{ palette.green }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.strong }}</span><span style="display:inline-block;margin-left:2px;padding:0 4px;border-radius:3px;background:{{ palette.amber_bg }};color:{{ palette.amber }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.fair }}</span><span style="display:inline-block;margin-left:2px;padding:0 4px;border-radius:3px;background:{{ palette.red_bg }};color:{{ palette.red }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.weak }}</span></td>
                  <td valign="top" style="padding:3px 0;font-size:10px;line-height:1.4;color:{{ palette.muted }};{% if not loop.first %}border-top:1px solid {{ palette.border }};{% endif %}">{{ r.description }}</td>
                </tr>
                {% endfor %}
              </table>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── [11] OPTIMIZER (two plans: buy-only vs buy & sell) ─── #}
          {% if optimizer.available %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Optimizer", optimizer.subtitle) }}
              {% for plan in optimizer.plans %}
              <div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.accent }};text-transform:uppercase;">
                {{ plan.label }}
                {# Which plan the configuration runs, then whether it can be
                   executed. Both plans are computed every run and both can be
                   executable, so the status alone left the reader with two trade
                   lists and no way to tell which one is the proposal. #}
                <span style="display:inline-block;margin-left:6px;padding:2px 7px;border-radius:999px;background:{{ palette.accent_bg if plan.active else palette.card_alt }};color:{{ palette.accent if plan.active else palette.muted }};font-size:9px;letter-spacing:0.04em;vertical-align:middle;">{{ 'ACTIVE' if plan.active else 'ALTERNATIVE' }}</span>
                {% if plan.execution_status %}
                <span style="display:inline-block;margin-left:6px;padding:2px 7px;border-radius:999px;background:{{ palette.green_bg if plan.executable else palette.red_bg }};color:{{ palette.green if plan.executable else palette.red }};border:1px solid {{ palette.green if plan.executable else palette.red }};font-size:9px;letter-spacing:0.04em;vertical-align:middle;">{% if plan.executable %}✓ {% endif %}{{ plan.execution_status|replace('_', ' ') }}</span>
                {% endif %}
              </div>
              {% if plan.execution_status == 'NON_EXECUTABLE' %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;background:{{ palette.red_bg }};border:1px solid {{ palette.red }};border-radius:8px;border-collapse:separate;border-spacing:0;">
                <tr><td style="padding:10px 12px;font-size:12px;color:{{ palette.ink }};line-height:1.5;">
                  <strong style="color:{{ palette.red }};">Not executable — draft only.</strong>
                  The funding proof ends with {{ plan.funding_ending_cash_eur }} cash against a protected {{ plan.funding_protected_cash_eur }} buffer{% if plan.funding_shortfall_eur %}, a {{ plan.funding_shortfall_eur }} shortfall{% endif %}. Do not treat the trades below as executable instructions.
                </td></tr>
              </table>
              {% endif %}
              {# One summary line, the concept's: how many trades, the money in
                 and out, and what executing costs. It was three lines -- a
                 green "funding verified" strip repeating the EXECUTABLE pill
                 beside the plan name, a totals line, and a cost line. #}
              <div style="margin-top:6px;font-size:11px;line-height:1.6;color:{{ palette.muted }};">
                {% if plan.execution_status == 'NON_EXECUTABLE' %}Draft: {% endif %}{{ plan.n_buy }} buy &middot; {{ plan.n_sell }} sell &middot; in <strong style="color:{{ palette.green }};">{{ plan.total_buy }}</strong> &middot; out <strong style="color:{{ palette.red }};">{{ plan.total_sell }}</strong>{% if plan.cost_total_eur %} &middot; estimated cost <strong style="color:{{ palette.red }};">{{ plan.cost_total_eur }}</strong>{% if plan.cgt_eur and plan.fees_eur %} of which CGT {{ plan.cgt_eur }} and fees {{ plan.fees_eur }}{% elif plan.cgt_eur %}, all tax (CGT){% else %}, all commission fees{% endif %}{% endif %}
              </div>
              {% if plan.actions %}
              {# Unified instrument table: per instrument, Now → Target → Trade
                 → After. A non-executable plan remains visible as diagnostic
                 evidence but is explicitly labeled draft-only above. #}
              {{ plan.table_html|safe }}
              {% elif plan.execution_status == 'NON_EXECUTABLE' %}
              <div style="margin-top:8px;padding:9px 12px;background:{{ palette.red_bg }};border-radius:8px;font-size:12px;color:{{ palette.red }};">No executable trade set was produced.</div>
              {% else %}
              <div style="margin-top:8px;padding:9px 12px;background:{{ palette.green_bg }};border:1px solid {{ palette.green_border }};border-radius:8px;font-size:12px;color:{{ palette.ink }};">Already on target: no trades needed.</div>
              {% endif %}
              {% endfor %}
            </td>
          </tr>
          {% endif %}

          {# No BACKTEST section. The long-history synthetic comparison ran to
             4,700px -- 28% of the issue, more than the eleven sections about
             the portfolio that actually exists -- to compare candidate
             portfolios the reader does not hold. It stays in the Excel export,
             where a reader who wants to compare candidates is already looking.
             ── #}

          {# ─── [12] APPENDIX — tax, method, feeds ─────────────
             Three reference blocks under one heading. They were three unnumbered
             blocks trailing off the end of the document, which read as an
             afterthought rather than as the place to look things up. #}
          {% if tax_note.available or methodology.available or ticker_sources.available %}
          <tr>
            <td class="px-32" style="padding:20px 20px 0 20px;">
              {{ sec(secn, "Appendix", "Tax estimate, return-window method, and the feed behind every instrument.") }}
            </td>
          </tr>
          {% endif %}
          {% if tax_note.available %}
          <tr>
            <td class="px-32" style="padding:12px 20px 0 20px;">
              {{ tax_note.html|safe }}
            </td>
          </tr>
          {% endif %}
          {% if methodology.available %}
          <tr>
            <td class="px-32" style="padding:12px 20px 0 20px;">
              {{ methodology.html|safe }}
            </td>
          </tr>
          {% endif %}
          {# ─── INSTRUMENT DATA SOURCES (compact audit) ───── #}
          {% if ticker_sources.available %}
          <tr>
            <td class="px-32" style="padding:12px 20px 0 20px;">
              <div style="font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.accent }};text-transform:uppercase;">Instrument data sources</div>
              <div style="margin-top:3px;font-size:9px;color:{{ palette.muted }};line-height:1.35;">Canonical and intraday ticker · latest dated provider observation in UTC. Daily bars may use a midnight date anchor.</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-top:8px;table-layout:fixed;border:1px solid {{ palette.border }};background:{{ palette.card_alt }};">
                <tr style="background:{{ palette.page }};">
                  <td width="36%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Instrument</td>
                  <td width="24%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Canonical feed</td>
                  <td width="24%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Intraday feed</td>
                  <td width="16%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Presence</td>
                </tr>
                {% for row in ticker_sources.rows %}
                <tr>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;line-height:1.2;">
                    <div style="font-size:8.5px;font-weight:600;color:{{ palette.ink }};">{{ row.name or row.ticker or "—" }}</div>
                    <div style="margin-top:1px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:7px;color:{{ palette.subtle }};">{{ row.isin or "—" }}</div>
                  </td>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;line-height:1.2;">
                    <div style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:8px;font-weight:700;color:{{ palette.accent }};">{{ row.ticker or "—" }}</div>
                    <div style="margin-top:1px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:6.8px;color:{{ palette.subtle }};white-space:nowrap;">{{ row.canonical_refresh_timestamp or "—" }}</div>
                  </td>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;line-height:1.2;">
                    <div style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:8px;font-weight:700;color:{{ palette.ink }};">{{ row.intraday_ticker or "—" }}</div>
                    <div style="margin-top:1px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:6.8px;color:{{ palette.subtle }};white-space:nowrap;">{{ row.intraday_refresh_timestamp or "—" }}</div>
                  </td>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;font-size:7.5px;color:{{ palette.muted }};line-height:1.25;">{{ row.portfolio_presence or "—" }}</td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>
          {% endif %}

          {# ─── FOOTER ────────────────────────────────────── #}
          <tr>
            <td class="px-32" style="padding:24px 20px 32px 20px;border-top:1px solid {{ palette.border }};">
              <div style="font-size:10px;color:{{ palette.subtle }};line-height:1.7;text-align:center;">
                generated {{ footer.generated_at }} · tarzan {{ footer.version }} · issue {{ header.issue_number }}<br>
                personal portfolio analytics · not investment advice · point-in-time, may be revised
              </div>
            </td>
          </tr>

        </table>
        <div style="margin-top:14px;font-size:11px;color:{{ palette.subtle }};">🌿 Tarzan. Built for the long swing.</div>
      </td>
    </tr>
  </table>
</body>
</html>
