{# =============================================================================
   Tarzan — Portfolio Digest · The Securities Statement (email-safe HTML, Jinja2)
   =============================================================================

   Context authority: tarzan.export.newsletter.build_context.

   The document is a statement of account laid out for a 390px phone in Apple
   Mail: one dark ground, no card surfaces, ledger rows, a double rule under the
   balance, every euro beside its percent, one stamp for the market state, and
   one continuous rule down the left that every section's ordinal is pinned to.

   Every section row has two cells: the gutter (14px + the 1px rail, carrying the
   ordinal box that straddles the rail) and the content column (354px). Section
   HTML that cannot be expressed in Jinja (charts, grids, bridges) is built by
   the newsletter modules and injected through |safe; builders escape provider
   text at their boundary.
============================================================================= #}
{#- The ordinal box in the gutter: it overlaps the rail by half its width. -#}
{% macro gutter(ns) -%}
{%- set ns.n = ns.n + 1 -%}
<td width="14" style="width:14px;border-right:1px solid {{ palette.border }};vertical-align:top;padding:17px 0 0 0;"><div style="width:26px;margin-left:1px;margin-right:-13px;background:{{ palette.page }};border:1px solid {{ palette.border }};border-radius:2px;text-align:center;font-size:11px;font-weight:700;line-height:1.5;color:{{ palette.muted }};font-variant-numeric:tabular-nums;">{{ "%02d"|format(ns.n) }}</div></td>
{%- endmacro %}
{#- The kicker: the label, then a rule that fills the line. Optional muted note. -#}
{% macro kick(label, sub=None) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="white-space:nowrap;padding-left:12px;{{ type.title }}color:{{ palette.ink }};">{{ label }}</td>
<td width="100%" style="padding-left:10px;"><div style="height:1px;background:{{ palette.border }};font-size:0;line-height:0;">&nbsp;</div></td>
</tr></table>
{%- if sub %}<div style="margin-top:4px;{{ type.note }}color:{{ palette.muted }};">{{ sub }}</div>{% endif -%}
{%- endmacro %}
{#- A block title inside a section: small caps with a rule, optional right note. -#}
{% macro h3(label, right=None) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px;border-bottom:1px solid {{ palette.border }};"><tr>
<td style="padding:0 0 4px 0;{{ type.label }}color:{{ palette.muted }};">{{ label }}</td>
{% if right %}<td align="right" style="padding:0 0 4px 0;font-size:{{ type_px.label }}px;color:{{ palette.faint }};">{{ right }}</td>{% endif %}
</tr></table>
{%- endmacro %}
{% macro sign_color(tone) -%}{% if tone == 'pos' %}{{ palette.green }}{% elif tone == 'neg' %}{{ palette.red }}{% else %}{{ palette.ink }}{% endif %}{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>Tarzan Portfolio Digest</title>
  <style>
    body, table, td, div, span { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; text-size-adjust: 100%; }
    body { margin: 0; padding: 0; background: {{ palette.page }}; font-family: {{ font_stack|safe }}; }
    table { border-collapse: collapse; }
    img { display: block; border: 0; }
    a { color: {{ palette.ink }}; text-decoration: none; }
    {# The column is the phone's width. A narrower pane reflows it; a wider one
       keeps the statement at its measure, centred. #}
    @media only screen and (max-width: 420px) {
      .container { width: 100% !important; }
    }
  </style>
</head>
{% set secn = namespace(n=0) %}
<body style="margin:0;padding:0;background:{{ palette.page }};font-family:{{ font_stack }};color:{{ palette.ink }};">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ palette.page }};">
    <tr>
      <td align="center" style="padding:0;">
        <table role="presentation" class="container" width="390" cellpadding="0" cellspacing="0" border="0" style="width:390px;max-width:390px;background:{{ palette.page }};table-layout:fixed;">

          {# ─── MASTHEAD · the statement header ─────────────────── #}
          <tr>
            <td width="14" style="width:14px;border-right:1px solid {{ palette.border }};">&nbsp;</td>
            <td style="padding:18px 13px 12px 8px;border-bottom:1px solid {{ palette.border }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                <td style="font-size:15px;font-weight:700;letter-spacing:0.22em;color:{{ palette.ink }};">TARZAN</td>
                <td align="right">{% set stamp_c = palette.green if header.market_open else palette.red %}<span style="display:inline-block;border:1.5px solid {{ stamp_c }};color:{{ stamp_c }};font-size:10px;font-weight:700;letter-spacing:0.14em;padding:3px 7px;border-radius:2px;text-transform:uppercase;white-space:nowrap;">market {{ 'open' if header.market_open else 'closed' }}</span></td>
              </tr></table>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:7px;"><tr>
                <td style="{{ type.prose }}color:{{ palette.muted }};font-variant-numeric:tabular-nums;white-space:nowrap;">Statement № {{ header.issue_number }} · {{ header.date_short }}</td>
                <td align="right" style="{{ type.prose }}color:{{ palette.muted }};font-variant-numeric:tabular-nums;white-space:nowrap;">{{ header.basis }}</td>
              </tr></table>
            </td>
          </tr>

          {# ═══ BODY ORDER ═══════════════════════════════════════════
             Ten sections, each with one question:
               01 state        what the portfolio is worth, made, returned
               02 performance  what it did over time, by window, against what
               03 movers       which lines moved the number, book and plan
               04 markets      what the market did
               05 allocation   where the money sits vs where it should
               06 holdings     the positions and how each performed
               07 target instr the plan's not-yet-held names
               08 watchlist    the instruments tracked, not held
               09 optimizer    what to do about it
               10 appendix     tax, the risk legend, feeds
             The ordinals come from the shared counter in gutter(), so a section
             the engine cannot fill leaves no hole in the sequence. #}

          {# ─── [01] STATE ─────────────────────────────────── #}
          {% include "partials/status.html.j2" %}

          {# ─── [02] PERFORMANCE ──────────────────────────────
             The value chart with P&L on the right axis, the KPI matrix (book,
             plan, market × windows), then the paths by window and since
             inception. Portfolio and Vs-the-market were two sections asking
             one question. #}
          {% if hero.value_chart or returns_snapshot.kpi_matrix_html or performance30.vs_market_html %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Performance") }}
              {% if hero.value_chart %}
              <div style="margin-top:12px;">{{ hero.value_chart|safe }}</div>
              {% if hero.value_chart_legend %}{{ hero.value_chart_legend|safe }}{% endif %}
              {% if hero.flow_chips_html %}{{ hero.flow_chips_html|safe }}{% endif %}
              {% endif %}
              {% if returns_snapshot and returns_snapshot.kpi_matrix_html %}{{ returns_snapshot.kpi_matrix_html|safe }}{% endif %}
              {% if performance30.available and performance30.vs_market_html %}
              {{ performance30.vs_market_html|safe }}
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── [03] PORTFOLIO MOVERS ───────────────────────
             Contribution (weight × return) per window, book and plan side by
             side on one list of instruments. Built in
             _sections_perf.py::_build_portfolio_movers. #}
          {% if portfolio_movers.available %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Portfolio movers") }}
              <div style="margin-top:10px;">{{ portfolio_movers.html|safe }}</div>
            </td>
          </tr>
          {% endif %}

          {# ─── [04] MARKETS ────────────────────────────────
             Indices, futures, bonds, commodities and currencies in two
             columns, then the news digest. #}
          {% if markets.available or ai_summary %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Markets", markets.sub) }}
              {% if markets.available %}{{ markets.html|safe }}{% endif %}
              {% if ai_summary %}
              <div style="margin-top:12px;border-top:1px solid {{ palette.border }};padding-top:8px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="{{ type.prose }}color:{{ palette.ink }};">{{ ai_summary_html|safe }}</table>
                <div style="margin-top:6px;{{ type.note }}color:{{ palette.subtle }};">AI-generated news digest · via Google Search · not financial advice</div>
              </div>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── [05] ALLOCATION ─────────────────────────────
             Asset class, equity geography and per-holding targets as bridges:
             today's stack, the plan's stack, each slice joined to itself.
             Pre-rendered in _sections_alloc.py::_build_diversification. #}
          {% if diversification.available %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Allocation") }}
              {{ diversification.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── [06] HOLDINGS ───────────────────────────────
             Each position with its book figures on the name line and its
             return over every window beneath. Returns and The book were two
             tables of the same names. #}
          {% if returns_snapshot.available %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Holdings") }}
              {{ returns_snapshot.table_html|safe }}
              {% if holdings.note %}<div style="margin-top:8px;{{ type.note }}color:{{ palette.muted }};">{{ holdings.note }}</div>{% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── [07] TARGET INSTRUMENTS ───────────────────── #}
          {% if performance.target_table_html %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Target instruments") }}
              {{ performance.target_table_html|safe }}
              <div style="margin-top:8px;{{ type.note }}color:{{ palette.muted }};">In the target portfolio, not held yet. Same columns, scaled on this table's own columns.</div>
            </td>
          </tr>
          {% endif %}

          {# ─── [08] WATCHLIST ──────────────────────────────── #}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Watchlist") }}
              {{ performance.table_html|safe }}
              <div style="margin-top:8px;{{ type.note }}color:{{ palette.muted }};">Instruments tracked, not held. Same columns, scaled on this table's own columns.</div>
            </td>
          </tr>

          {# ─── [09] OPTIMIZER (two plans: buy-only vs buy & sell) ─── #}
          {% if optimizer.available %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Optimizer", optimizer.subtitle) }}
              {% for plan in optimizer.plans %}
              <div data-tarzan-funding-plan="{{ loop.index0 }}" data-tarzan-funding-status="{{ plan.execution_status|default('UNKNOWN', true) }}" data-tarzan-target-alignment="{{ 'proven' if plan.aligned else 'unproven' }}" data-tarzan-broker-execution-verified="false" data-tarzan-action-count="{{ plan.n_total|default(0) }}">
              <div style="margin-top:16px;">
                <span style="{{ type.title }}letter-spacing:0.06em;color:{{ palette.ink }};">{{ plan.label|e }}</span>
                {# ACTIVE selects a modeled proposal. Funding/model checks are
                   not an assertion that a broker can execute these orders. #}
                <span style="display:inline-block;margin-left:6px;padding:1px 5px;border-radius:2px;background:{{ palette.accent_bg }};color:{{ palette.ink if plan.active else palette.muted }};font-size:9.5px;font-weight:700;letter-spacing:0.06em;vertical-align:middle;">{{ 'ACTIVE' if plan.active else 'ALTERNATIVE' }}</span>
                <span data-tarzan-funding-badge="true" style="display:inline-block;margin-left:4px;padding:1px 5px;border-radius:2px;background:{{ palette.green_bg if plan.executable else palette.red_bg if plan.execution_status == 'NON_EXECUTABLE' else palette.amber_bg }};color:{{ palette.green if plan.executable else palette.red if plan.execution_status == 'NON_EXECUTABLE' else palette.amber }};font-size:9.5px;font-weight:700;letter-spacing:0.06em;vertical-align:middle;">{{ 'CHECKS PASSED' if plan.executable else 'NOT EXECUTABLE · DRAFT' if plan.execution_status == 'NON_EXECUTABLE' else 'UNKNOWN · DRAFT' }}</span>
              </div>
              {# The scope disclaimer, inside each plan: the semantic gate checks
                 its exact words per plan, so it is a note here and not a
                 section-level paragraph. #}
              <div data-tarzan-funding-scope="limited" style="margin-top:4px;{{ type.note }}color:{{ palette.subtle }};">Funding, position and policy checks use selected prices only. Broker lot sizes/fractional orders, settlement timing and execution prices are not verified. These are modeled proposals, not broker instructions.</div>
              {# One summary line: how many trades, the money in and out, and
                 what executing costs. #}
              <div style="margin-top:5px;{{ type.prose }}color:{{ palette.ink }};font-variant-numeric:tabular-nums;">
                {% if not plan.executable %}Draft: {% endif %}{{ plan.n_buy }} buy &middot; {{ plan.n_sell }} sell &middot; in <strong style="color:{{ palette.green }};">{{ plan.total_buy }}</strong> &middot; out <strong style="color:{{ palette.red }};">{{ plan.total_sell }}</strong>{% if plan.cost_total_eur %} &middot; estimated cost <strong style="color:{{ palette.red }};">{{ plan.cost_total_eur }}</strong>{% if plan.cgt_eur and plan.fees_eur %} of which CGT {{ plan.cgt_eur }} and fees {{ plan.fees_eur }}{% elif plan.cgt_eur %}, all tax (CGT){% else %}, all commission fees{% endif %}{% endif %}
              </div>
              {% if plan.execution_status == 'NON_EXECUTABLE' %}
              <div style="margin-top:8px;padding:6px 0 6px 8px;border-left:3px solid {{ palette.red }};{{ type.note }}color:{{ palette.ink }};">
                <strong style="color:{{ palette.red }};">Not executable — draft only.</strong>
                Final funding, position or policy checks failed. The components below come from the final planner proof; a strategic reserve held in securities is not spendable bank cash.
              </div>
              {% elif not plan.executable %}
              <div style="margin-top:8px;padding:6px 0 6px 8px;border-left:3px solid {{ palette.amber }};{{ type.note }}color:{{ palette.ink }};">{% if not plan.funding_available %}Funding proof unavailable.{% else %}Funding proof incomplete or unrecognized.{% endif %} Draft only; missing amounts are unavailable, not zero.</div>
              {% endif %}
              {% if plan.actions %}
              {# Per instrument, Now → After → Target, with the class rail. A
                 non-executable plan remains visible as diagnostic evidence but
                 is explicitly labeled draft-only above. #}
              {{ plan.table_html|safe }}
              {% endif %}
              {# The funding proof. A plan that trades gets the ledger; a plan with
                 nothing to fund states the same proof in one running line (the
                 gate reads every field either way). #}
              {% if plan.actions %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;table-layout:fixed;{{ type.data }}font-weight:400;">
                <colgroup><col><col style="width:84px;"><col style="width:84px;"></colgroup>
                <tr style="color:{{ palette.muted }};"><td style="padding:4px 0;border-bottom:1px solid {{ palette.border }};{{ type.label }}">Final proof components</td><td align="right" style="padding:4px 0;border-bottom:1px solid {{ palette.border }};{{ type.label }}">Before</td><td align="right" style="padding:4px 0;border-bottom:1px solid {{ palette.border }};{{ type.label }}">After</td></tr>
                {% for row in plan.funding_pairs %}
                <tr><td style="padding:4px 4px 4px 0;border-bottom:1px solid {{ palette.row_rule }};color:{{ palette.muted }};">{{ row.label }}</td><td align="right" style="padding:4px 0;border-bottom:1px solid {{ palette.row_rule }};color:{{ palette.ink }};font-variant-numeric:tabular-nums;"><span data-tarzan-funding-field="{{ row.before.field }}" data-eur="{{ row.before.raw }}">{{ row.before.text }}</span></td><td align="right" style="padding:4px 0;border-bottom:1px solid {{ palette.row_rule }};color:{{ palette.ink }};font-variant-numeric:tabular-nums;"><span data-tarzan-funding-field="{{ row.after.field }}" data-eur="{{ row.after.raw }}">{{ row.after.text }}</span></td></tr>
                {% endfor %}
                {% for row in plan.funding_details %}
                <tr><td colspan="2" style="padding:4px 4px 4px 0;border-bottom:1px solid {{ palette.row_rule }};color:{{ palette.muted }};">{{ row.label }}</td><td align="right" style="padding:4px 0;border-bottom:1px solid {{ palette.row_rule }};color:{{ palette.ink }};font-variant-numeric:tabular-nums;"><span data-tarzan-funding-field="{{ row.amount.field }}" data-eur="{{ row.amount.raw }}">{{ row.amount.text }}</span></td></tr>
                {% endfor %}
              </table>
              {% else %}
              <div style="margin-top:6px;{{ type.note }}color:{{ palette.muted }};font-variant-numeric:tabular-nums;"><span style="{{ type.label }}color:{{ palette.muted }};">Final proof</span> {% for row in plan.funding_pairs %}{{ row.label }} <span style="color:{{ palette.ink }};" data-tarzan-funding-field="{{ row.before.field }}" data-eur="{{ row.before.raw }}">{{ row.before.text }}</span> → <span style="color:{{ palette.ink }};" data-tarzan-funding-field="{{ row.after.field }}" data-eur="{{ row.after.raw }}">{{ row.after.text }}</span>{% if not loop.last or plan.funding_details %} · {% endif %}{% endfor %}{% for row in plan.funding_details %}{{ row.label }} <span style="color:{{ palette.ink }};" data-tarzan-funding-field="{{ row.amount.field }}" data-eur="{{ row.amount.raw }}">{{ row.amount.text }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</div>
              {% endif %}
              {% if plan.actions %}
              {% elif plan.execution_status == 'NON_EXECUTABLE' %}
              <div data-tarzan-funding-outcome="not-executable" style="margin-top:8px;padding:6px 0 6px 8px;border-left:3px solid {{ palette.red }};{{ type.note }}color:{{ palette.red }};">No executable trade set was produced; draft only.</div>
              {% elif plan.aligned %}
              <div data-tarzan-funding-outcome="aligned" style="margin-top:8px;padding:6px 0 6px 8px;border-left:3px solid {{ palette.green }};{{ type.note }}color:{{ palette.ink }};">Checked targets within tolerance; no trades proposed.</div>
              {% else %}
              <div data-tarzan-funding-outcome="unproven" style="margin-top:8px;padding:6px 0 6px 8px;border-left:3px solid {{ palette.amber }};{{ type.note }}color:{{ palette.ink }};">No trades proposed{% if plan.infeasible %}; no feasible plan was produced{% endif %}. Target alignment has not been proven.</div>
              {% endif %}
              </div>
              {% endfor %}
              {# The disclosures once, for the section, not once per plan. #}
              <div style="margin-top:12px;border-top:1px solid {{ palette.border }};padding-top:8px;{{ type.note }}color:{{ palette.muted }};">Bank cash funds the modeled trades; securities require an explicit sale. The strategic reserve combines cash and cash-equivalent securities. Amounts are displayed to cents; proof facts retain their source precision.</div>
            </td>
          </tr>
          {% endif %}

          {# ─── [10] APPENDIX — tax, the risk legend, feeds ───── #}
          {% if tax_note.available or risk_legend or ticker_sources.available %}
          <tr>
            {{ gutter(secn) }}
            <td style="padding:18px 13px 0 8px;">
              {{ kick("Appendix") }}
              {% if tax_note.available %}
              <div style="margin-top:10px;">{{ tax_note.html|safe }}</div>
              {% endif %}
              {% if risk_legend %}
              {{ h3("Risk metrics", "bands") }}
              {% if risk_window_note %}
              <div style="margin-top:5px;{{ type.note }}color:{{ palette.muted }};">{{ risk_window_note }}</div>
              {% endif %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:4px;">
                {% for r in risk_legend %}
                <tr>
                  <td style="padding:6px 0 1px 0;{{ type.prose }}font-weight:700;color:{{ palette.ink }};white-space:nowrap;width:70px;">{{ r.label }}</td>
                  <td align="right" style="padding:6px 0 1px 0;"><span style="display:inline-block;padding:1px 5px;border-radius:2px;background:{{ palette.green_bg }};color:{{ palette.green }};font-size:9.5px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;font-variant-numeric:tabular-nums;">{{ r.strong_label }} {{ r.strong }}</span><span style="display:inline-block;margin-left:3px;padding:1px 5px;border-radius:2px;background:{{ palette.amber_bg }};color:{{ palette.amber }};font-size:9.5px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;font-variant-numeric:tabular-nums;">{{ r.fair_label }} {{ r.fair }}</span><span style="display:inline-block;margin-left:3px;padding:1px 5px;border-radius:2px;background:{{ palette.red_bg }};color:{{ palette.red }};font-size:9.5px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;font-variant-numeric:tabular-nums;">{{ r.weak_label }} {{ r.weak }}</span></td>
                </tr>
                <tr><td colspan="2" style="padding:0 0 6px 0;border-bottom:1px solid {{ palette.row_rule }};{{ type.note }}color:{{ palette.muted }};">{{ r.description }}</td></tr>
                {% endfor %}
              </table>
              {% if risk_alpha_beta_note %}
              <div style="margin-top:6px;{{ type.note }}color:{{ palette.subtle }};">* {{ risk_alpha_beta_note }}</div>
              {% endif %}
              {% if risk_backtest_note %}
              <div style="margin-top:4px;{{ type.note }}color:{{ palette.subtle }};">&#9432; {{ risk_backtest_note }}</div>
              {% endif %}
              {% endif %}
              {% if ticker_sources.available %}
              {{ h3("Instrument data sources", ticker_sources.rows|length) }}
              <div style="margin-top:5px;{{ type.note }}color:{{ palette.muted }};">Every instrument this issue names · the exact provider listing behind its daily bars and (↗) its intraday series. Held first, then watchlist, then closed positions; alphabetical within each.{% if ticker_sources.intraday_note %} {{ ticker_sources.intraday_note }}{% endif %}</div>
              {% if ticker_sources.quality_note %}<div style="margin-top:4px;{{ type.note }}color:{{ palette.muted }};">{{ ticker_sources.quality_note }}</div>{% endif %}
              {{ ticker_sources.table_html|safe }}
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── FOOTER ────────────────────────────────────── #}
          <tr>
            <td width="14" style="width:14px;border-right:1px solid {{ palette.border }};">&nbsp;</td>
            <td style="padding:22px 13px 30px 8px;">
              <div style="border-top:1px solid {{ palette.border }};padding-top:10px;{{ type.note }}color:{{ palette.subtle }};">
                generated {{ footer.generated_at }} · tarzan {{ footer.version }} · issue {{ header.issue_number }}<br>
                personal portfolio analytics · not investment advice · point-in-time, may be revised
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
