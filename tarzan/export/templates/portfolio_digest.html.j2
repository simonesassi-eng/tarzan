{# =============================================================================
   Tarzan — Portfolio Digest (email-safe HTML, Jinja2 template)
   =============================================================================

   Context authority: tarzan.export.newsletter.build_context.

   The context contains palette/header/hero data plus the preformatted
   performance, market, diversification, holdings, risk, optimizer, backtest,
   contribution, tax, and methodology sections consumed below. Section HTML
   is built by the focused newsletter modules before template rendering.

   Display values are preformatted; section mappings remain structured so the
   template can control availability and layout without recomputing analytics.
============================================================================= #}
{# One definition for every section kicker: a running ordinal in accent, then
   the label. The counter lives in a namespace and is incremented HERE, so it
   numbers the sections actually rendered. A static number per section left
   holes in the sequence whenever an optional block (market context, optimizer)
   was unavailable. #}
{% macro sec(ns, label) -%}
{%- set ns.n = ns.n + 1 -%}
<div style="font-size:12.5px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:{{ palette.ink }};"><span style="color:{{ palette.accent }};">[{{ "%02d"|format(ns.n) }}]</span>&nbsp;&nbsp;{{ label }}</div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# The palette is dark, so declare it: a client told "light" may auto-invert
     a dark document and produce colours nobody chose. #}
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>Tarzan Portfolio Digest</title>
  <style>
    body { margin: 0; padding: 0; background: {{ palette.page }}; font-family: ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace; }
    table { border-collapse: collapse; }
    img { display: block; border: 0; }
    a { color: {{ palette.accent }}; text-decoration: none; }
    @media only screen and (max-width: 620px) {
      .container { width: 100% !important; }
      .kpi-cell  { display: block !important; width: 100% !important; box-sizing: border-box; }
      .px-32     { padding-left: 20px !important; padding-right: 20px !important; }
    }
  </style>
</head>
{% set secn = namespace(n=0) %}
<body style="margin:0;padding:0;background:{{ palette.page }};font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;color:{{ palette.ink }};">

  {# -- Preheader (hidden, shown as preview text in inbox) -- #}
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ palette.page }};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:{{ palette.card }};border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,0.06);">

          {# ─── STATUS BAR ───────────────────────────────────────
             One terse line above the masthead: the figures a reader checks
             before deciding whether to read on. Built in
             _sections_alloc.py::_build_header as header.status_bar; entries
             that the engine cannot supply are absent, not blank. #}
          {% if header.status_bar %}
          <tr>
            <td class="px-32" style="padding:14px 32px;background:{{ palette.page }};border-bottom:1px solid {{ palette.border }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  {% for b in header.status_bar %}
                  <td align="{{ 'left' if loop.first else 'right' }}" style="white-space:nowrap;font-size:10px;">
                    {# No text-transform here: CSS uppercase maps the beta label to capital Beta,
   which renders as a plain "B". The labels are already written in caps. #}<span style="font-weight:700;letter-spacing:0.08em;color:{{ palette.subtle }};">{{ b.label }}</span>&nbsp;<span style="font-weight:700;font-variant-numeric:tabular-nums;color:{% if b.tone == 'pos' %}{{ palette.green }}{% elif b.tone == 'neg' %}{{ palette.red }}{% else %}{{ palette.ink }}{% endif %};">{{ b.value }}</span>
                  </td>
                  {% endfor %}
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}

          {# ─── HEADER ───────────────────────────────────────── #}
          <tr>
            <td class="px-32" style="padding:28px 32px 20px 32px;background:{{ palette.card }};border-bottom:1px solid {{ palette.border }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" style="vertical-align:middle;">
                    <div style="font-size:14px;font-weight:700;letter-spacing:0.04em;color:{{ palette.accent }};text-transform:uppercase;">🌿&nbsp;Tarzan</div>
                    <div style="margin-top:4px;font-size:22px;font-weight:700;color:{{ palette.ink }};line-height:1.2;">Portfolio Digest</div>
                  </td>
                  <td align="right" style="vertical-align:middle;font-size:12px;color:{{ palette.muted }};line-height:1.4;">
                    <div>{{ header.date_short }}</div>
                    <div>Issue #{{ header.issue_number }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {# ─── STATUS ─────────────────────────────────────── #}
          {# Chart-led hero + Profit&Losses / TWROR scoreboard + annualized
             cards + slim rebalance banner. See partials/status.html.j2. #}
          {% include "partials/status.html.j2" %}


          {# ─── PERFORMANCE (1D/7D/30D/since matrix + 30-day charts) ─────────
             Owns the multi-horizon P&L / TWROR numbers and the recent
             trajectory. The hero above is now a slim lifetime-state band so
             no figure appears twice. SVG charts render in Gmail/Apple Mail;
             legacy Outlook shows the matrix + chips (PNG fallback is a TODO).
             Pre-rendered in newsletter.py::_build_performance30 (SVG can't be
             expressed in Jinja), injected as safe HTML. #}
          {% if performance30.available %}
          <tr>
            <td class="px-32" style="padding:28px 32px 0 32px;">
              {{ performance30.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── MARKETS (compact two-column strip) ───────────────
             Every index with its session path, level and change, in two
             columns split on a region boundary. Sits above the AI
             market-context note so the data backs the narrative. The kicker
             lives here, with the shared numbering, rather than inside the
             builder's HTML. #}
          {% if markets.available %}
          <tr>
            <td class="px-32" style="padding:28px 32px 0 32px;">
              {{ sec(secn, "Markets") }}
              {{ markets.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── MARKET CONTEXT (AI) ─────────────────────────────
             Macro recap of the last 24-48h tied to the portfolio's
             exposures, grounded via Google Search. Renders directly below
             the "How your money moved" charts. When unavailable (no API key)
             no market-context block is shown. #}
          {% if ai_summary %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              {{ sec(secn, "Market context") }}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-left:4px solid {{ palette.accent }};border-radius:8px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:14px 16px;">
                    <div style="font-size:13.5px;color:{{ palette.ink }};line-height:1.55;">{{ ai_summary_html|safe }}</div>
                    <div style="margin-top:8px;font-size:10px;color:{{ palette.subtle }};">✨ AI-generated market context · news may be imperfect · not financial advice</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}


          {# ─── DIVERSIFICATION (tile dashboard: asset class + geography +
             by holding) — pre-rendered in newsletter.py::_build_diversification
             (SVG donut gauges + 1-month trend sparklines can't be expressed in
             Jinja), injected as safe HTML. Each tile shows the actual weight, a
             donut gauge whose fill is that weight with an ink notch at the
             target, a drift pill, and a last-month trend vs target. ── #}
          {% if diversification.available %}
          <tr>
            <td class="px-32" style="padding:28px 32px 0 32px;">
              {{ diversification.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── HOLDINGS (All positions) — the book, placed before the grids that
   dissect it: a reader meets the positions, then their returns. #}
          {% include "partials/holdings.html.j2" %}

          {# ─── RETURNS SNAPSHOT (per-holding × period) ─────── #}
          {% if returns_snapshot.available %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              {{ sec(secn, "Returns snapshot") }}
              <div style="margin-top:4px;font-size:12px;color:{{ palette.muted }};">Portfolio vs {{ returns_snapshot.benchmark_alpha_beta }}: <span style="color:{{ palette.green }};font-weight:700;">●</span> beat · <span style="color:{{ palette.amber }};font-weight:700;">●</span> in line · <span style="color:{{ palette.red }};font-weight:700;">●</span> under</div>
              {{ returns_snapshot.table_html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── PERFORMANCE — RETURNS BY ASSET CLASS & ROLE ──────
             Sectioned table (asset class · role) with a 1D intraday
             sparkline. Pre-rendered in newsletter.py::_build_performance
             (SVG sparklines + grouping can't be expressed in Jinja),
             injected as safe HTML — same pattern as Markets. #}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              {{ sec(secn, performance.kicker) }}
              <div style="margin-top:4px;font-size:12px;color:{{ palette.muted }};">{{ performance.subtitle_html|safe }}</div>
              {{ performance.table_html|safe }}
            </td>
          </tr>

          {# ─── RETURN CONTRIBUTION — waterfall, then the two ranked lists ─ #}
          {% if return_contrib.winners or return_contrib.laggards %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              {{ sec(secn, "Return contribution") }}
              <div style="margin-top:2px;font-size:12px;color:{{ palette.muted }};">What moved the number. Each bar starts where the previous one ended, so the movers and everything else add up to the unrealized return in <strong style="color:{{ palette.ink }};">STATE</strong>.</div>
              {% if return_contrib.chart_html %}
              <div style="margin-top:12px;border:1px solid {{ palette.border }};border-radius:10px;overflow:hidden;">{{ return_contrib.chart_html|safe }}</div>
              {% endif %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;">
                <tr>
                  <td width="50%" valign="top" style="padding:0 9px 0 0;">
                    {% if return_contrib.winners %}
                    <div style="font-size:10px;font-weight:700;letter-spacing:0.06em;color:{{ palette.green }};text-transform:uppercase;">▲ Top contributors</div>
                    {% for w in return_contrib.winners %}
                    <div style="margin-top:6px;font-size:11px;color:{{ palette.ink }};">{{ w.name|truncate(26, true, '…') }}<b style="color:{{ palette.green }};float:right;font-variant-numeric:tabular-nums;">{{ w.value }}</b></div>
                    {% endfor %}
                    {% endif %}
                  </td>
                  <td width="50%" valign="top" style="padding:0 0 0 9px;border-left:1px solid {{ palette.border }};">
                    {% if return_contrib.laggards %}
                    <div style="font-size:10px;font-weight:700;letter-spacing:0.06em;color:{{ palette.red }};text-transform:uppercase;">▼ Laggards</div>
                    {% for l in return_contrib.laggards %}
                    <div style="margin-top:6px;font-size:11px;color:{{ palette.ink }};">{{ l.name|truncate(26, true, '…') }}<b style="color:{{ palette.red }};float:right;font-variant-numeric:tabular-nums;">{{ l.value }}</b></div>
                    {% endfor %}
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}
          {# ─── RISK PROFILE — UNIFIED TABLE — after attribution and immediately
   before the optimizer, so the evidence precedes the action. #}
          {% if risk_profile.available %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              {{ sec(secn, risk_profile.title) }}
              {% if risk_profile.portfolio_note %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:9px 12px;background:{{ palette.accent_bg }};border:1px solid {{ palette.border }};border-left:4px solid {{ palette.accent }};border-radius:8px;font-size:11px;color:{{ palette.ink }};line-height:1.5;">&#9432; {{ risk_profile.portfolio_note }}</td>
                </tr>
              </table>
              {% endif %}
              {# Unified instrument table (same shell as Holdings / Returns /
                 Performance / Optimizer), pre-rendered in
                 _sections_perf.py::_build_risk_profile. #}
              {{ risk_profile.table_html|safe }}
              {% if risk_profile.alpha_beta_note %}
              <div style="margin-top:6px;font-size:10px;color:{{ palette.subtle }};">* {{ risk_profile.alpha_beta_note }}</div>
              {% endif %}

              {# Legend — same content as the Excel Performance tab Legend #}
              {% if risk_profile.legend %}
              <div style="margin-top:20px;">{{ sec(secn, "Legend") }}</div>
              <div style="margin-top:2px;font-size:11px;color:{{ palette.muted }};">Bands next to each metric: <span style="color:{{ palette.green }};font-weight:700;">strong</span> &middot; <span style="color:{{ palette.amber }};font-weight:700;">fair</span> &middot; <span style="color:{{ palette.red }};font-weight:700;">weak</span>.</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;border-collapse:separate;border-spacing:6px;">
                {% for r in risk_profile.legend %}
                {% if loop.index0 % 2 == 0 %}<tr>{% endif %}
                <td width="50%" valign="top" style="padding:8px 10px;background:{{ palette.card_alt }};border:1px solid {{ palette.border }};border-radius:9px;">
                  <div style="line-height:1.6;">
                    <span style="font-size:12px;font-weight:700;color:{{ palette.ink }};">{{ r.label }}</span><span style="display:inline-block;margin-left:3px;padding:0 5px;border-radius:4px;background:{{ palette.green_bg }};color:{{ palette.green }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.strong }}</span><span style="display:inline-block;margin-left:3px;padding:0 5px;border-radius:4px;background:{{ palette.amber_bg }};color:{{ palette.amber }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.fair }}</span><span style="display:inline-block;margin-left:3px;padding:0 5px;border-radius:4px;background:{{ palette.red_bg }};color:{{ palette.red }};font-size:9px;font-weight:700;font-variant-numeric:tabular-nums;">{{ r.weak }}</span>
                  </div>
                  <div style="margin-top:3px;font-size:10px;line-height:1.45;color:{{ palette.muted }};">{{ r.description }}</div>
                </td>
                {% if loop.index0 % 2 == 1 or loop.last %}</tr>{% endif %}
                {% endfor %}
              </table>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {# ─── OPTIMIZER ACTION (two plans: buy-only vs buy & sell) ─── #}
          {% if optimizer.available %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              {{ sec(secn, "Optimizer") }}
              {% for plan in optimizer.plans %}
              <div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.accent }};text-transform:uppercase;">
                {{ plan.label }}
                {% if plan.execution_status %}
                <span style="display:inline-block;margin-left:6px;padding:2px 7px;border-radius:999px;background:{{ palette.green_bg if plan.executable else palette.red_bg }};color:{{ palette.green if plan.executable else palette.red }};border:1px solid {{ palette.green if plan.executable else palette.red }};font-size:9px;letter-spacing:0.04em;vertical-align:middle;">{{ plan.execution_status|replace('_', ' ') }}</span>
                {% endif %}
              </div>
              {% if plan.execution_status == 'NON_EXECUTABLE' %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;background:{{ palette.red_bg }};border:1px solid {{ palette.red }};border-radius:8px;border-collapse:separate;border-spacing:0;">
                <tr><td style="padding:10px 12px;font-size:12px;color:{{ palette.ink }};line-height:1.5;">
                  <strong style="color:{{ palette.red }};">Not executable — draft only.</strong>
                  The funding proof ends with {{ plan.funding_ending_cash_eur }} cash against a protected {{ plan.funding_protected_cash_eur }} buffer{% if plan.funding_shortfall_eur %}, a {{ plan.funding_shortfall_eur }} shortfall{% endif %}. Do not treat the trades below as executable instructions.
                </td></tr>
              </table>
              {% elif plan.execution_status == 'EXECUTABLE' %}
              <div style="margin-top:6px;padding:6px 10px;background:{{ palette.green_bg }};border-radius:7px;font-size:11px;color:{{ palette.green }};">Funding verified · ending cash {{ plan.funding_ending_cash_eur }} · protected buffer {{ plan.funding_protected_cash_eur }}</div>
              {% endif %}
              {% if plan.funding_flow_html %}
              {# The same proof as a picture: each term of the cash identity is
                 a bar and the last one is their sum, so the reader can see the
                 plan pay for itself instead of taking the sentence on faith. #}
              <div style="margin-top:8px;border:1px solid {{ palette.border }};border-radius:10px;overflow:hidden;">{{ plan.funding_flow_html|safe }}</div>
              {% endif %}
              <div style="margin-top:5px;font-size:12px;color:{{ palette.muted }};">
                {% if plan.execution_status == 'NON_EXECUTABLE' %}Draft: {% endif %}{{ plan.n_buy }} BUY &nbsp;·&nbsp; {{ plan.n_sell }} SELL &nbsp;·&nbsp; total
                <span style="color:{{ palette.green }};font-weight:600;">{{ plan.total_buy }}</span> in,
                <span style="color:{{ palette.red }};font-weight:600;">{{ plan.total_sell }}</span> out,
                net <span style="color:{{ plan.net_color }};font-weight:600;">{{ plan.net }}</span>
              </div>
              {% if plan.cost_total_eur %}
              {# Estimated cost of executing the plan: CGT on the sells + fixed
                 commission fees. Only shown when non-zero. #}
              <div style="margin-top:3px;font-size:12px;color:{{ palette.muted }};">
                Est. cost <span style="color:{{ palette.red }};font-weight:700;">{{ plan.cost_total_eur }}</span>
                {% if plan.cgt_eur %}&nbsp;·&nbsp; tax (CGT) {{ plan.cgt_eur }}{% endif %}
                {% if plan.fees_eur %}&nbsp;·&nbsp; fees {{ plan.fees_eur }}{% endif %}
              </div>
              {% endif %}
              {% if plan.actions %}
              {# Unified instrument table: per instrument, Now → Target → Trade
                 → After. A non-executable plan remains visible as diagnostic
                 evidence but is explicitly labeled draft-only above. #}
              {{ plan.table_html|safe }}
              {% elif plan.execution_status == 'NON_EXECUTABLE' %}
              <div style="margin-top:8px;padding:9px 12px;background:{{ palette.red_bg }};border-radius:8px;font-size:12px;color:{{ palette.red }};">No executable trade set was produced.</div>
              {% else %}
              <div style="margin-top:8px;padding:9px 12px;background:{{ palette.green_bg }};border:1px solid {{ palette.green_border }};border-radius:8px;font-size:12px;color:{{ palette.ink }};">Already on target: no trades needed.</div>
              {% endif %}
              {% endfor %}
            </td>
          </tr>
          {% endif %}

          {# ─── BACKTESTING (long-history synthetic comparison of candidate
             portfolios) — rendered right after the Optimizer. Guarded and
             cached: only present when the backtest ran (see
             _sections_backtest.py). ── #}
          {% if backtesting.available %}
          <tr>
            <td class="px-32" style="padding:32px 32px 0 32px;">
              {{ backtesting.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── NET-OF-TAX NOTE (estimate) — moved to the very bottom so it
             does not crowd the Performance headline numbers. ── #}
          {% if tax_note.available %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              {{ tax_note.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── METHODOLOGY (actual return-window spans) ───── #}
          {% if methodology.available %}
          <tr>
            <td class="px-32" style="padding:24px 32px 0 32px;">
              {{ methodology.html|safe }}
            </td>
          </tr>
          {% endif %}

          {# ─── INSTRUMENT DATA SOURCES (compact audit) ───── #}
          {% if ticker_sources.available %}
          <tr>
            <td class="px-32" style="padding:20px 32px 0 32px;">
              <div style="font-size:11px;font-weight:700;letter-spacing:0.06em;color:{{ palette.accent }};text-transform:uppercase;">Instrument data sources</div>
              <div style="margin-top:3px;font-size:9px;color:{{ palette.muted }};line-height:1.35;">Canonical and intraday ticker · latest dated provider observation in UTC. Daily bars may use a midnight date anchor.</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-top:8px;table-layout:fixed;border:1px solid {{ palette.border }};background:{{ palette.card_alt }};">
                <tr style="background:{{ palette.page }};">
                  <td width="36%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Instrument</td>
                  <td width="24%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Canonical feed</td>
                  <td width="24%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Intraday feed</td>
                  <td width="16%" style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};font-size:7.5px;font-weight:700;color:{{ palette.muted }};text-transform:uppercase;">Presence</td>
                </tr>
                {% for row in ticker_sources.rows %}
                <tr>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;line-height:1.2;">
                    <div style="font-size:8.5px;font-weight:600;color:{{ palette.ink }};">{{ row.name or row.ticker or "—" }}</div>
                    <div style="margin-top:1px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:7px;color:{{ palette.subtle }};">{{ row.isin or "—" }}</div>
                  </td>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;line-height:1.2;">
                    <div style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:8px;font-weight:700;color:{{ palette.accent }};">{{ row.ticker or "—" }}</div>
                    <div style="margin-top:1px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:6.8px;color:{{ palette.subtle }};white-space:nowrap;">{{ row.canonical_refresh_timestamp or "—" }}</div>
                  </td>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;line-height:1.2;">
                    <div style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:8px;font-weight:700;color:{{ palette.ink }};">{{ row.intraday_ticker or "—" }}</div>
                    <div style="margin-top:1px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:6.8px;color:{{ palette.subtle }};white-space:nowrap;">{{ row.intraday_refresh_timestamp or "—" }}</div>
                  </td>
                  <td style="padding:4px 5px;border-bottom:1px solid {{ palette.border }};vertical-align:top;font-size:7.5px;color:{{ palette.muted }};line-height:1.25;">{{ row.portfolio_presence or "—" }}</td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>
          {% endif %}

          {# ─── FOOTER ────────────────────────────────────── #}
          <tr>
