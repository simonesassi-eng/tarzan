  "positive_scope": {
    "package_entries": [
      "tarzan/__init__.py",
      "tarzan/version.py",
      "tarzan/main.py",
      "tarzan/orchestrator.py",
      "tarzan/backtest.py",
      "tarzan/contracts",
      "tarzan/config",
      "tarzan/data",
