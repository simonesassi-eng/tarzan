      "tarzan/export",
      "tarzan/instruments",
      "tarzan/models",
      "tarzan/runtime",
      "tarzan/release_manifest.json"
    ],
    "test_roots": [
      "tarzan/tests"
    ],
    "script_roots": [
      "scripts/"
    ],
    "named_release_files": [
      ".github/workflows/newsletter.yml",
      "README.md",
      "tarzan/README.md",
      "requirements.in",
      "requirements.txt"
    ]
  },
  "validation_commands": [
    "python scripts/validate_release.py --manifest tarzan/release_manifest.json",
    "python -m compileall -q tarzan scripts",
    "python -m pytest tarzan/tests -q"
  ]
