    "gemini_model": "gemini-2.5-flash"
  },
  "schema_versions": {
    "input": "2",
    "summary": "2",
    "ledger": "1.0",
    "manifest": "1.0",
    "cache": "1",
    "exposure": "1.0",
    "capability": "1.0",
    "provider_policy": "1.0",
    "telemetry": "1.0",
    "delivery_identity": "1.0",
    "delivery_state": "1.0"
  },
  "pin_review": {
