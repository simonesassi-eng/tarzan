#!/bin/sh
# Reject a commit message carrying a real money figure.
#
# This repo is PUBLIC. Commit messages here are narrative and quote live runs,
# which is how portfolio totals, P&L and sleeve sizes came to be readable by
# anyone. See .githooks/_money.sh for what counts and what is let through.
#
# Deliberate exception: git commit --no-verify
#
# ponytail: this hook sees the message only. The staged diff is pre-commit's job.

. "$(dirname "$0")/_money.sh"

# Strip comment lines so a commented-out template cannot trip the hook.
if hits=$(grep -v '^#' "$1" | grep -oE "$MONEY_PATTERN"); then
	echo "commit-msg: real money figure in the commit message — this repo is public." >&2
	echo "$hits" | sort -u | sed 's/^/  /' >&2
	echo "" >&2
	echo "Round it away (\"a six-figure book\"), drop it, or: git commit --no-verify" >&2
	exit 1
fi
