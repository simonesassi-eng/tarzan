#!/bin/sh
# Reject a STAGED line that adds a real money figure to the tree.
#
# commit-msg guards what you write ABOUT a change; this guards what the change
# itself says. It exists because after the messages were guarded the tree kept
# leaking anyway: ten sites came back within ten days, every one of them a
# comment or docstring quoting a live run, which is the house style for
# explaining a bug and is not going to stop.
#
# Excluded by path: fixtures that are synthetic by construction.
# Excluded by line: any line containing "synthetic" — mark a deliberate stand-in
# and this hook believes you. The marker earns its keep on its own, because a
# reader currently cannot tell which figures in this tree were ever real.
#
# Escape for a whole commit: git commit --no-verify

. "$(dirname "$0")/_money.sh"

status=0
files=$(git diff --cached --name-only --diff-filter=d -- . \
	':(exclude)tarzan/tests/golden' \
	':(exclude)tarzan/stress' \
	':(exclude).githooks')

for f in $files; do
	hits=$(git diff --cached -U0 -- "$f" \
		| grep '^+' | grep -v '^+++' \
		| grep -vi 'synthetic' \
		| grep -oE "$MONEY_PATTERN" | sort -u)
	if [ -n "$hits" ]; then
		if [ $status -eq 0 ]; then
			echo "pre-commit: a real money figure is being added — this repo is public." >&2
			status=1
		fi
		echo "  $f" >&2
		echo "$hits" | sed 's/^/      /' >&2
	fi
done

if [ $status -ne 0 ]; then
	echo "" >&2
	echo 'Round it away, swap in a synthetic stand-in, or put "synthetic" on the line.' >&2
	echo "Whole-commit escape: git commit --no-verify" >&2
fi
exit $status
